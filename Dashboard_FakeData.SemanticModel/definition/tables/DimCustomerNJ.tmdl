	measure 'Customer Active Weeks' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimDate[Year Week] ),
			        CALCULATE (
			            [Branch Order Count],
			            REMOVEFILTERS ( FactBranchCost[company] )
			        ) > 0
			    )
			)
		formatString: 0
		lineageTag: cd0350ca-7683-47ea-9ee7-c122a28490a1

	measure 'Customer Natural Order Interval' =
			
			DIVIDE (
			    [Customer Effective Coverage Weeks],
			    [Customer Active Weeks]
			)
		lineageTag: b1fea63e-8f7a-414f-a68e-3750efcca512

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Suggested Visit Cycle' =
			
			VAR NaturalInterval =
			    [Customer Natural Order Interval]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( NaturalInterval ), BLANK (),
			        NaturalInterval <= 1.5, 1,
			        NaturalInterval <= 2.5, 2,
			        NaturalInterval <= 3.5, 3,
			        NaturalInterval <= 5, 4,
			        NaturalInterval <= 7, 6,
			        8
			    )
		formatString: 0
		lineageTag: 474273a3-7b31-4705-b250-10235e267c34

	measure 'Customer Visit Frequency Label' =
			
			VAR Cycle =
			    [Customer Suggested Visit Cycle]
			RETURN
			    SWITCH(
			        Cycle,
			        1, "Every-Week Type",
			        2, "2-Week Type",
			        3, "3-Week Type",
			        4, "4-Week Type",
			        5, "5-Week Type",
			        6, "6-Week Type",
			        8, "8-Week Type",
			        "Inactive/Review"
			    )
		lineageTag: 8a5f3712-cbac-4de0-b1c3-14bd8c1d3309

	measure 'Customer Visit Factor' =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerAll[Customer Type] )
			RETURN
			    SWITCH (
			        CustomerType,
			        "Wholesaler", 0.5,
			        "Supermarket/Grocery", 1,
			        "Retail", 1,
			        "On-Premise", 1,
			        "Pharmacy", 0.5,
			        "E-Commerce", 0,
			        0
			    )
		lineageTag: 4d78be3f-3468-48e3-b9e8-dbf4a889f542

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Cycle Weekly Load' =
			
			VAR Cycle =
			    [Customer Suggested Visit Cycle]
			RETURN
			    IF(
			        [Customer Sales_All Branches] > 0
			            && NOT ISBLANK(Cycle),
			        DIVIDE(1, Cycle),
			        0
			    )
		lineageTag: f5aaa0e8-7f35-4095-a42c-c6af38e6b393

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Adjusted Weekly Load' =
			
			[Customer Cycle Weekly Load]
			    * [Customer Visit Factor]
		lineageTag: 50f723c7-569c-4875-8b9e-154f09e665a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salesperson Total Weekly Load' =
			
			SUMX(
			    VALUES(DimCustomerAll[Customer ID]),
			    CALCULATE([Customer Adjusted Weekly Load])
			)
		lineageTag: 5c37fd75-7254-435c-ab81-ea74ebcbb257

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salesperson Capacity Utilization' =
			
			DIVIDE ( [Salesperson Total Weekly Load], 20 )
		lineageTag: 429bad10-cb5a-4b02-a431-f909f9fb6ba0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salesperson Load Status' =
			
			VAR ActiveCustomerCount =
			    COUNTROWS(
			        FILTER(
			            VALUES(DimCustomerAll[Customer ID]),
			            CALCULATE([Customer Adjusted Weekly Load]) > 0
			        )
			    )
			VAR CapacityRate =
			    [Salesperson Capacity Utilization]
			RETURN
			    SWITCH(
			        TRUE(),
			        ActiveCustomerCount = 0, "NON-FIELD",
			        CapacityRate > 1.15, "OVERLOAD",
			        CapacityRate > 1, "FULL / REVIEW",
			        CapacityRate >= 0.8, "HEALTHY",
			        CapacityRate >= 0.5, "AVAILABLE",
			        "LOW FIELD LOAD"
			    )
		lineageTag: 73b888d9-9d4e-4157-b9f0-d07ba7e6319e

	measure 'Salesperson Capacity Color' =
			
			VAR CapacityRate =
			    [Salesperson Capacity Utilization]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CapacityRate), "#BDBDBD",
			        CapacityRate > 1.15, "#C62828",
			        CapacityRate > 1, "#F57C00",
			        CapacityRate >= 0.8, "#2E7D32",
			        CapacityRate >= 0.5, "#1976D2",
			        "#9E9E9E"
			    )
		lineageTag: 174c4291-3a49-4cd2-89dc-acdaee4d5b60

	measure 'Salesperson Customer Count' =
			
			CALCULATE(
			    DISTINCTCOUNT(DimCustomerAll[Customer ID]),
			    DimCustomerAll[Customer ID] <> BLANK()
			)
		formatString: 0
		lineageTag: 0dd93492-ff7c-495b-ba42-7e1501ea6b35

	measure 'Customer Effective Coverage Weeks' =
			
			VAR FirstOrderDate =
			    SELECTEDVALUE ( DimCustomerAll[Customer First Order Date] )
			
			VAR SelectedStartDate =
			    MIN ( DimDate[Date] )
			
			VAR SelectedEndDate =
			    MAX ( DimDate[Date] )
			
			VAR EffectiveStartDate =
			    IF (
			        FirstOrderDate > SelectedStartDate,
			        FirstOrderDate,
			        SelectedStartDate
			    )
			
			RETURN
			    IF (
			        ISBLANK ( FirstOrderDate ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( VALUES ( DimDate[Year Week] ) ),
			            DATESBETWEEN (
			                DimDate[Date],
			                EffectiveStartDate,
			                SelectedEndDate
			            )
			        )
			    )
		formatString: 0
		lineageTag: 96882d12-7fbb-4fb8-b6e4-1b003079fd5c

	measure 'Route Customer Visit Factor' =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerNJ[Customer Type] )
			RETURN
			    SWITCH (
			        CustomerType,
			        "Wholesaler", 0.5,
			        "Supermarket/Grocery", 1,
			        "Retail", 1,
			        "On-Premise", 1,
			        "Pharmacy", 0.5,
			        "E-Commerce", 0,
			        "Employee", 0,
			        "Others", 1,
			        0
			    )
		lineageTag: f9c0049c-8a69-45fb-9267-0edd63725405

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Route Customer Weekly Visits' =
			
			VAR Cycle =
			    [Route Customer Suggested Visit Cycle]
			VAR VisitFactor =
			    [Route Customer Visit Factor]
			VAR CustomerSales =
			    [Route Customer Sales]
			RETURN
			    IF (
			        CustomerSales > 0
			            && NOT ISBLANK ( Cycle ),
			        DIVIDE (
			            VisitFactor,
			            Cycle,
			            0
			        ),
			        0
			    )
		lineageTag: 8c5bd71c-130e-444e-9443-c6d37392365c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Route Customer Minutes per Visit' =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerNJ[Customer Type] )
			VAR ServiceMinutes =
			    LOOKUPVALUE (
			        DimCustomerServiceTime[Minutes per Visit],
			        DimCustomerServiceTime[Customer Type],
			        CustomerType
			    )
			RETURN
			    IF (
			        ISBLANK ( CustomerType ),
			        BLANK (),
			        COALESCE ( ServiceMinutes, 30 )
			    )
		formatString: 0
		lineageTag: 20593d9c-09b8-4a91-83e9-55203282ac65

	measure 'Route Customer Expected Weekly Minutes' =
			
			[Route Customer Weekly Visits]
			    * [Route Customer Minutes per Visit]
		lineageTag: fb3bff2a-0c0f-4e1c-97ca-fe5528269b03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

