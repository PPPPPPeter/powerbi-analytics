	measure 客户活跃周数 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimDate[年周] ),
			        CALCULATE (
			            [分公司订单数],
			            REMOVEFILTERS ( FactBranchCost[company] )
			        ) > 0
			    )
			)
		formatString: 0
		lineageTag: cd0350ca-7683-47ea-9ee7-c122a28490a1

	measure 客户自然订货间隔 =
			
			DIVIDE (
			    [客户有效覆盖周数],
			    [客户活跃周数]
			)
		lineageTag: b1fea63e-8f7a-414f-a68e-3750efcca512

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 客户建议拜访周期 =
			
			VAR NaturalInterval =
			    [客户自然订货间隔]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( NaturalInterval ), BLANK (),
			        NaturalInterval <= 1.5, 1,
			        NaturalInterval <= 2.5, 2,
			        NaturalInterval <= 3.5, 3,
			        NaturalInterval <= 5, 4,
			        NaturalInterval <= 7, 6,
			        8
			    )
		formatString: 0
		lineageTag: 474273a3-7b31-4705-b250-10235e267c34

	measure 客户拜访频率标签 =
			
			VAR Cycle =
			    [客户建议拜访周期]
			RETURN
			    SWITCH(
			        Cycle,
			        1, "每周型",
			        2, "2周型",
			        3, "3周型",
			        4, "4周型",
			        5, "5周型",
			        6, "6周型",
			        8, "8周型",
			        "Inactive/Review"
			    )
		lineageTag: 8a5f3712-cbac-4de0-b1c3-14bd8c1d3309

	measure 客户拜访系数 =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerAll[客户类型] )
			RETURN
			    SWITCH (
			        CustomerType,
			        "Wholesaler", 0.5,
			        "Supermarket/Grocery", 1,
			        "Retail", 1,
			        "On-Premise", 1,
			        "Pharmacy", 0.5,
			        "E-Commerce", 0,
			        0
			    )
		lineageTag: 4d78be3f-3468-48e3-b9e8-dbf4a889f542

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 客户周期周负荷 =
			
			VAR Cycle =
			    [客户建议拜访周期]
			RETURN
			    IF(
			        [客户销售额_全部分公司] > 0
			            && NOT ISBLANK(Cycle),
			        DIVIDE(1, Cycle),
			        0
			    )
		lineageTag: f5aaa0e8-7f35-4095-a42c-c6af38e6b393

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 客户调整后周负荷 =
			
			[客户周期周负荷]
			    * [客户拜访系数]
		lineageTag: 50f723c7-569c-4875-8b9e-154f09e665a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 销售人员总周负荷 =
			
			SUMX(
			    VALUES(DimCustomerAll[客户编号]),
			    CALCULATE([客户调整后周负荷])
			)
		lineageTag: 5c37fd75-7254-435c-ab81-ea74ebcbb257

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 销售人员产能利用率 =
			
			DIVIDE ( [销售人员总周负荷], 20 )
		lineageTag: 429bad10-cb5a-4b02-a431-f909f9fb6ba0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 销售人员负荷状态 =
			
			VAR ActiveCustomerCount =
			    COUNTROWS(
			        FILTER(
			            VALUES(DimCustomerAll[客户编号]),
			            CALCULATE([客户调整后周负荷]) > 0
			        )
			    )
			VAR CapacityRate =
			    [销售人员产能利用率]
			RETURN
			    SWITCH(
			        TRUE(),
			        ActiveCustomerCount = 0, "NON-FIELD",
			        CapacityRate > 1.15, "OVERLOAD",
			        CapacityRate > 1, "FULL / REVIEW",
			        CapacityRate >= 0.8, "HEALTHY",
			        CapacityRate >= 0.5, "AVAILABLE",
			        "LOW FIELD LOAD"
			    )
		lineageTag: 73b888d9-9d4e-4157-b9f0-d07ba7e6319e

	measure 销售人员产能颜色 =
			
			VAR CapacityRate =
			    [销售人员产能利用率]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(CapacityRate), "#BDBDBD",
			        CapacityRate > 1.15, "#C62828",
			        CapacityRate > 1, "#F57C00",
			        CapacityRate >= 0.8, "#2E7D32",
			        CapacityRate >= 0.5, "#1976D2",
			        "#9E9E9E"
			    )
		lineageTag: 174c4291-3a49-4cd2-89dc-acdaee4d5b60

	measure 销售负责客户数 =
			
			CALCULATE(
			    DISTINCTCOUNT(DimCustomerAll[客户编号]),
			    DimCustomerAll[客户编号] <> BLANK()
			)
		formatString: 0
		lineageTag: 0dd93492-ff7c-495b-ba42-7e1501ea6b35

	measure 客户有效覆盖周数 =
			
			VAR FirstOrderDate =
			    SELECTEDVALUE ( DimCustomerAll[客户首次下单日期] )
			
			VAR SelectedStartDate =
			    MIN ( DimDate[Date] )
			
			VAR SelectedEndDate =
			    MAX ( DimDate[Date] )
			
			VAR EffectiveStartDate =
			    IF (
			        FirstOrderDate > SelectedStartDate,
			        FirstOrderDate,
			        SelectedStartDate
			    )
			
			RETURN
			    IF (
			        ISBLANK ( FirstOrderDate ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( VALUES ( DimDate[年周] ) ),
			            DATESBETWEEN (
			                DimDate[Date],
			                EffectiveStartDate,
			                SelectedEndDate
			            )
			        )
			    )
		formatString: 0
		lineageTag: 96882d12-7fbb-4fb8-b6e4-1b003079fd5c

	measure 路线客户拜访系数 =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerNJ[客户类型] )
			RETURN
			    SWITCH (
			        CustomerType,
			        "Wholesaler", 0.5,
			        "Supermarket/Grocery", 1,
			        "Retail", 1,
			        "On-Premise", 1,
			        "Pharmacy", 0.5,
			        "E-Commerce", 0,
			        "Employee", 0,
			        "Others", 1,
			        0
			    )
		lineageTag: f9c0049c-8a69-45fb-9267-0edd63725405

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 路线客户每周拜访次数 =
			
			VAR Cycle =
			    [路线客户建议拜访周期]
			VAR VisitFactor =
			    [路线客户拜访系数]
			VAR CustomerSales =
			    [路线客户销售额]
			RETURN
			    IF (
			        CustomerSales > 0
			            && NOT ISBLANK ( Cycle ),
			        DIVIDE (
			            VisitFactor,
			            Cycle,
			            0
			        ),
			        0
			    )
		lineageTag: 8c5bd71c-130e-444e-9443-c6d37392365c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 路线客户单次服务分钟 =
			
			VAR CustomerType =
			    SELECTEDVALUE ( DimCustomerNJ[客户类型] )
			VAR ServiceMinutes =
			    LOOKUPVALUE (
			        DimCustomerServiceTime[单次服务分钟],
			        DimCustomerServiceTime[客户类型],
			        CustomerType
			    )
			RETURN
			    IF (
			        ISBLANK ( CustomerType ),
			        BLANK (),
			        COALESCE ( ServiceMinutes, 30 )
			    )
		formatString: 0
		lineageTag: 20593d9c-09b8-4a91-83e9-55203282ac65

	measure 路线客户预计每周服务分钟 =
			
			[路线客户每周拜访次数]
			    * [路线客户单次服务分钟]
		lineageTag: fb3bff2a-0c0f-4e1c-97ca-fe5528269b03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

