table DimCustomerNJ
	lineageTag: 89555466-c50d-4df2-8ff2-ced8c2e8b8ac

	measure 'Customer Sales_All Branches' =
			
			CALCULATE (
			    [Branch Sales (Excl Freight and Service Fees)],
			    REMOVEFILTERS ( FactBranchCost[company] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 29078a7e-04c1-469c-bd20-dbd72717a829

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Customer Gross Profit_All Branches' =
			
			CALCULATE (
			    [Product Price_Gross Profit],
			    REMOVEFILTERS ( FactBranchCost[company] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c6a2cdae-822f-428c-b9d2-6c1db6677d63

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Customer Purchase Frequency_All Branches' =
			
			CALCULATE (
			    [Branch Order Count],
			    REMOVEFILTERS ( FactBranchCost[company] )
			)
		formatString: 0
		lineageTag: c2f9128c-9e2d-4300-9903-98b5709eb456

	measure 'Customer Net SKU Qty_All Branches' =
			
			VAR SKUList =
			    CALCULATETABLE (
			        VALUES ( FactBranchCost[Ref Num] ),
			        REMOVEFILTERS ( FactBranchCost[company] )
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            SKUList,
			            NOT ISBLANK ( FactBranchCost[Ref Num] )
			                && CALCULATE (
			                    SUM ( FactBranchCost[quantity] ),
			                    REMOVEFILTERS ( FactBranchCost[company] )
			                ) > 0
			        )
			    )
		formatString: 0
		lineageTag: 04441ba3-f2b2-4afa-a1c2-9ff2bf526e03

	measure 'Customer Positive Sales_All Branches' =
			
			CALCULATE (
			    [Branch Sales (Excl Freight and Service Fees)],
			    FactBranchCost[amount] > 0,
			    REMOVEFILTERS ( FactBranchCost[company] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3352d5d9-cc9d-41d2-a695-3d28b116f6ac

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Customer Return Amount_All Branches' =
			
			ABS (
			    CALCULATE (
			        [Branch Sales (Excl Freight and Service Fees)],
			        FactBranchCost[amount] < 0,
			        REMOVEFILTERS ( FactBranchCost[company] )
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: f2b73f73-2f94-4603-93e6-b8ec82f668cb

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Customer Return Rate' =
			
			DIVIDE (
			    [Customer Return Amount_All Branches],
			    [Customer Positive Sales_All Branches],
			    0
			)
		lineageTag: e579e12a-356e-415b-86e5-f8cfd0507773

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Sales Score' =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[Customer ID] )
			
			VAR CurrentType =
			    SELECTEDVALUE ( DimCustomerAll[Customer Type] )
			
			VAR IsWholesaler =
			    CurrentType = "Wholesaler"
			
			VAR CurrentValue =
			    [Graded Sales]
			
			VAR CustomerStats =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                DimCustomerAll,
			                DimCustomerAll[Customer ID],
			                DimCustomerAll[Customer Type]
			            ),
			            "@MetricValue",
			                CALCULATE ( [Graded Sales] )
			        ),
			
			        -- clear the current customer to build the full customer comparison pool
			        REMOVEFILTERS ( DimCustomerAll ),
			
			        REMOVEFILTERS ( FactBranchCost[customer_no] ),
			        REMOVEFILTERS ( FactBranchCost[customer_name] ),
			        REMOVEFILTERS ( FactBranchCost[customer_type] ),
			        REMOVEFILTERS ( FactBranchCost[salesperson] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR CustomerPool =
			    FILTER (
			        CustomerStats,
			        VAR PoolType =
			            DimCustomerAll[Customer Type]
			        VAR PoolValue =
			            [@MetricValue]
			        RETURN
			            IF (
			                IsWholesaler,
			                PoolType = "Wholesaler",
			                PoolType <> "Wholesaler"
			                    && NOT ISBLANK ( PoolType )
			            )
			                && NOT ISBLANK ( PoolValue )
			                && PoolValue > 0
			    )
			
			VAR PoolCount =
			    COUNTROWS ( CustomerPool )
			
			VAR P90 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.90 )
			
			VAR P75 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.75 )
			
			VAR P50 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.50 )
			
			VAR P25 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.25 )
			
			RETURN
			    IF (
			        ISBLANK ( CurrentCustomer )
			            || ISBLANK ( CurrentType )
			            || ISBLANK ( CurrentValue )
			            || PoolCount < 2,
			        BLANK (),
			        SWITCH (
			            TRUE (),
			            CurrentValue <= 0, 0,
			            CurrentValue >= P90, 100,
			            CurrentValue >= P75, 85,
			            CurrentValue >= P50, 70,
			            CurrentValue >= P25, 50,
			            25
			        )
			    )
		formatString: 0
		lineageTag: 023a3a72-93fc-4204-849e-27d151b56933

