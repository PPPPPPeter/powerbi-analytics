	measure 'Customer Return Performance Score' =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[Customer ID] )
			
			VAR CurrentType =
			    TRIM (
			        SELECTEDVALUE ( DimCustomerAll[Customer Type], "" )
			    )
			
			VAR PositiveSales =
			    [Graded Positive Sales]
			
			VAR ReturnRate =
			    [Graded Return Rate]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        -- current context is not a single customer
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        -- no customer type
			        CurrentType = "",
			            BLANK (),
			
			        -- wholesale customers get no return score
			        CurrentType = "Wholesaler",
			            BLANK (),
			
			        -- no positive sales
			        ISBLANK ( PositiveSales )
			            || PositiveSales <= 0,
			            BLANK (),
			
			        -- score by return rate
			        ReturnRate <= 0, 100,
			        ReturnRate <= 0.01, 90,
			        ReturnRate <= 0.03, 75,
			        ReturnRate <= 0.05, 60,
			        ReturnRate <= 0.10, 30,
			        0
			    )
		formatString: 0
		lineageTag: 770142d6-0239-4df3-acb0-7fcc830d30c6

	measure 'Customer Overall Score' =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[Customer ID] )
			
			VAR CustomerType =
			    TRIM (
			        SELECTEDVALUE ( DimCustomerAll[Customer Type], "" )
			    )
			
			VAR IsWholesaler =
			    CustomerType = "Wholesaler"
			
			VAR SalesScore =
			    [Customer Sales Score]
			
			VAR GrossProfitScore =
			    [Customer Gross Profit Score]
			
			VAR SKUScore =
			    [Customer SKU Qty Score]
			
			VAR FrequencyScore =
			    [Customer Purchase Frequency Score]
			
			VAR ReturnScore =
			    [Customer Return Performance Score]
			
			VAR RetailComplete =
			    NOT ISBLANK ( SalesScore )
			        && NOT ISBLANK ( GrossProfitScore )
			        && NOT ISBLANK ( SKUScore )
			        && NOT ISBLANK ( FrequencyScore )
			        && NOT ISBLANK ( ReturnScore )
			
			VAR WholesaleComplete =
			    NOT ISBLANK ( SalesScore )
			        && NOT ISBLANK ( GrossProfitScore )
			        && NOT ISBLANK ( FrequencyScore )
			
			VAR RetailScore =
			    SalesScore * 0.25
			        + GrossProfitScore * 0.30
			        + SKUScore * 0.20
			        + FrequencyScore * 0.15
			        + ReturnScore * 0.10
			
			VAR WholesaleScore =
			    SalesScore * 0.40
			        + GrossProfitScore * 0.40
			        + FrequencyScore * 0.20
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        CustomerType = "",
			            BLANK (),
			
			        IsWholesaler && NOT WholesaleComplete,
			            BLANK (),
			
			        NOT IsWholesaler && NOT RetailComplete,
			            BLANK (),
			
			        IsWholesaler,
			            ROUND ( WholesaleScore, 1 ),
			
			        ROUND ( RetailScore, 1 )
			    )
		lineageTag: c5e7bb02-5f24-48b8-a0ba-0f36b6674f8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Grade' =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[Customer ID] )
			
			VAR Score =
			    [Customer Overall Score]
			
			VAR GrossProfit =
			    [Graded Gross Profit]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        ISBLANK ( Score ),
			            BLANK (),
			
			        ISBLANK ( GrossProfit ),
			            BLANK (),
			
			        -- gross profit <= 0 caps the grade at B even with a score of 80+
			        GrossProfit <= 0 && Score >= 80,
			            "B",
			
			        Score >= 80, "A",
			        Score >= 65, "B",
			        Score >= 50, "C",
			        "D"
			    )
		lineageTag: 7fe141d3-73d5-4af4-a69d-7005f8fa0847

	measure 'Salesperson Graded Customers' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimCustomerAll[Customer ID] ),
			        VAR CustomerGrade =
			            CALCULATE ( [Customer Grade] )
			        RETURN
			            NOT ISBLANK ( CustomerGrade )
			    )
			)
		formatString: 0
		lineageTag: 09ead6d3-7254-4a1a-884e-8ca29dfe2639

