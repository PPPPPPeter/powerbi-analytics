			    )
		formatString: 0
		lineageTag: 10bad47e-aa05-41f6-96bb-c2b6ce75fec6

	measure 'Customer SKU Qty Score' =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[Customer ID] )
			
			VAR CurrentType =
			    SELECTEDVALUE ( DimCustomerAll[Customer Type] )
			
			VAR IsWholesaler =
			    CurrentType = "Wholesaler"
			
			VAR CurrentValue =
			    [Graded SKU Qty]
			
			VAR CustomerStats =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                DimCustomerAll,
			                DimCustomerAll[Customer ID],
			                DimCustomerAll[Customer Type]
			            ),
			            "@MetricValue",
			                CALCULATE ( [Graded SKU Qty] )
			        ),
			
			        -- clear the current customer to build the non-wholesale comparison pool
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( FactBranchCost[customer_no] ),
			        REMOVEFILTERS ( FactBranchCost[customer_name] ),
			        REMOVEFILTERS ( FactBranchCost[customer_type] ),
			        REMOVEFILTERS ( FactBranchCost[salesperson] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR CustomerPool =
			    FILTER (
			        CustomerStats,
			        VAR PoolType =
			            DimCustomerAll[Customer Type]
			        VAR PoolValue =
			            [@MetricValue]
			        RETURN
			            PoolType <> "Wholesaler"
			                && NOT ISBLANK ( PoolType )
			                && NOT ISBLANK ( PoolValue )
			                && PoolValue > 0
			    )
			
			VAR PoolCount =
			    COUNTROWS ( CustomerPool )
			
			VAR P90 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.90 )
			
			VAR P75 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.75 )
			
			VAR P50 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.50 )
			
			VAR P25 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.25 )
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        ISBLANK ( CurrentType ),
			            BLANK (),
			
			        -- wholesale customers get no SKU score
			        IsWholesaler,
			            BLANK (),
			
			        ISBLANK ( CurrentValue ),
			            BLANK (),
			
			        PoolCount < 2,
			            BLANK (),
			
			        CurrentValue <= 0, 0,
			        CurrentValue >= P90, 100,
			        CurrentValue >= P75, 85,
			        CurrentValue >= P50, 70,
			        CurrentValue >= P25, 50,
			        25
			    )
		formatString: 0
		lineageTag: 8d7f6d40-ef51-4eb1-9660-99d324901802

