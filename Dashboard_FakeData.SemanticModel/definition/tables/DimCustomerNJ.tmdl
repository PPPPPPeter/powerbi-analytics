	measure 'Graded Purchase Frequency' =
			
			VAR FirstOrderDate =
			    SELECTEDVALUE ( DimCustomerAll[Customer First Order Date] )
			
			VAR LastDataDate =
			    CALCULATE (
			        MAX ( FactBranchCost[Invoice Date] ),
			        REMOVEFILTERS ( DimDate ),
			        REMOVEFILTERS ( FactBranchCost[company] ),
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( FactBranchCost[customer_no] ),
			        REMOVEFILTERS ( FactBranchCost[customer_name] )
			    )
			
			VAR ActiveMonthCount =
			    IF (
			        NOT ISBLANK ( FirstOrderDate )
			            && NOT ISBLANK ( LastDataDate ),
			        DATEDIFF (
			            DATE (
			                YEAR ( FirstOrderDate ),
			                MONTH ( FirstOrderDate ),
			                1
			            ),
			            DATE (
			                YEAR ( LastDataDate ),
			                MONTH ( LastDataDate ),
			                1
			            ),
			            MONTH
			        ) + 1
			    )
			
			VAR TotalOrders =
			    CALCULATE (
			        [Branch Order Count],
			        REMOVEFILTERS ( DimDate ),
			        REMOVEFILTERS ( FactBranchCost[company] ),
			        REMOVEFILTERS ( DimCustomerAll[Salesperson] ),
			        REMOVEFILTERS ( FactBranchCost[salesperson] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			RETURN
			    IF (
			        ISBLANK ( FirstOrderDate ),
			        BLANK (),
			        DIVIDE ( TotalOrders, ActiveMonthCount )
			    )
		formatString: 0
		lineageTag: c2a80841-ccba-4aae-9ef4-8b2e4d956e5d

	measure 'Graded Positive Sales' =
			
