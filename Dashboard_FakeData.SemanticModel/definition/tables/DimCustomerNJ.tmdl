	measure 客户SKU数量得分 =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[客户编号] )
			
			VAR CurrentType =
			    SELECTEDVALUE ( DimCustomerAll[客户类型] )
			
			VAR IsWholesaler =
			    CurrentType = "Wholesaler"
			
			VAR CurrentValue =
			    [评级SKU数量]
			
			VAR CustomerStats =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE (
			                DimCustomerAll,
			                DimCustomerAll[客户编号],
			                DimCustomerAll[客户类型]
			            ),
			            "@MetricValue",
			                CALCULATE ( [评级SKU数量] )
			        ),
			
			        -- 清除当前客户，建立全部非批发客户比较池
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( FactBranchCost[customer_no] ),
			        REMOVEFILTERS ( FactBranchCost[customer_name] ),
			        REMOVEFILTERS ( FactBranchCost[customer_type] ),
			        REMOVEFILTERS ( FactBranchCost[salesperson] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR CustomerPool =
			    FILTER (
			        CustomerStats,
			        VAR PoolType =
			            DimCustomerAll[客户类型]
			        VAR PoolValue =
			            [@MetricValue]
			        RETURN
			            PoolType <> "Wholesaler"
			                && NOT ISBLANK ( PoolType )
			                && NOT ISBLANK ( PoolValue )
			                && PoolValue > 0
			    )
			
			VAR PoolCount =
			    COUNTROWS ( CustomerPool )
			
			VAR P90 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.90 )
			
			VAR P75 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.75 )
			
			VAR P50 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.50 )
			
			VAR P25 =
			    PERCENTILEX.INC ( CustomerPool, [@MetricValue], 0.25 )
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        ISBLANK ( CurrentType ),
			            BLANK (),
			
			        -- 批发客户不计算SKU得分
			        IsWholesaler,
			            BLANK (),
			
			        ISBLANK ( CurrentValue ),
			            BLANK (),
			
			        PoolCount < 2,
			            BLANK (),
			
			        CurrentValue <= 0, 0,
			        CurrentValue >= P90, 100,
			        CurrentValue >= P75, 85,
			        CurrentValue >= P50, 70,
			        CurrentValue >= P25, 50,
			        25
			    )
		formatString: 0
		lineageTag: 8d7f6d40-ef51-4eb1-9660-99d324901802

