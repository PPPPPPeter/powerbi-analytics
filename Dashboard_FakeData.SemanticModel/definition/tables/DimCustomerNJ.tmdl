	column 地图地址 =
			
			VAR FullAddress =
			    TRIM ( DimCustomerNJ[完整地址] )
			VAR City =
			    TRIM ( DimCustomerNJ[城市] )
			VAR StateName =
			    TRIM ( DimCustomerNJ[省州] )
			RETURN
			    IF (
			        FullAddress = "",
			        BLANK (),
			        IF (
			            City <> ""
			                && CONTAINSSTRING (
			                    UPPER ( FullAddress ),
			                    UPPER ( City )
			                ),
			            FullAddress & ", United States",
			            FullAddress
			                & IF ( City <> "", ", " & City, "" )
			                & IF ( StateName <> "", ", " & StateName, "" )
			                & ", United States"
			        )
			    )
		lineageTag: 3361c21f-661c-45de-b32d-ba2ca9e42a80
		dataCategory: Address
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 负责销售人员 =
			
			VAR CurrentCustomer =
			    DimCustomerNJ[客户编号]
			VAR LatestCustomerRecord =
			    TOPN(
			        1,
			        FILTER(
			            ALL(FactSalesAll),
			            FactSalesAll[合作伙伴/参考] = CurrentCustomer
			                && NOT ISBLANK(FactSalesAll[合作伙伴/销售员])
			                && FactSalesAll[合作伙伴/销售员] <> ""
			        ),
			        FactSalesAll[发票/账单日期], DESC
			    )
			RETURN
			    MAXX(
			        LatestCustomerRecord,
			        FactSalesAll[合作伙伴/销售员]
			    )
		lineageTag: e0eb6f9d-6118-4ba5-9bb4-de03fe267753
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 客户首次下单日期 =
			
			VAR CurrentCustomer =
			    DimCustomerNJ[客户编号]
			
			VAR FirstDateBranchCost =
			    MINX(
			        FILTER(
			            ALL(FactBranchCost),
			            FactBranchCost[customer_no] = CurrentCustomer
			        ),
			        FactBranchCost[Invoice Date]
			    )
			
			VAR FirstDateSalesAll =
			    MINX(
			        FILTER(
			            ALL(FactSalesAll),
			            FactSalesAll[合作伙伴/参考] = CurrentCustomer
			        ),
			        FactSalesAll[发票/账单日期]
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(FirstDateBranchCost), FirstDateSalesAll,
			        ISBLANK(FirstDateSalesAll), FirstDateBranchCost,
			        MIN(FirstDateBranchCost, FirstDateSalesAll)
			    )
		formatString: General Date
		lineageTag: 566ccff6-6f83-410e-a7e5-750ba2a23774
		summarizeBy: none

		variation Variation
			isDefault
			relationship: f7d36921-c625-40a0-a44b-0279706c07fa
			defaultHierarchy: LocalDateTable_72cebef0-949b-483f-8d5b-30d0dbb027fb.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 地址可用标记 =
			
			IF (
			    NOT ISBLANK ( DimCustomerNJ[客户编号] )
			        && NOT ISBLANK ( DimCustomerNJ[完整地址] )
			        && NOT ISBLANK ( DimCustomerNJ[城市] )
			        && NOT ISBLANK ( DimCustomerNJ[省州] ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: af8b97d1-4fbd-4ddc-ab62-e66d9c6f31ab
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 地址状态 =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( DimCustomerNJ[完整地址] ), "缺少街道地址",
			    ISBLANK ( DimCustomerNJ[城市] ), "缺少城市",
			    ISBLANK ( DimCustomerNJ[省州] ), "缺少州",
			    "地址完整"
			)
		lineageTag: 39e02c17-0b65-42b7-864d-eafda43f8f53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 路线数据状态 =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( DimCustomerNJ[客户编号] ), "缺少客户编号",
			    ISBLANK ( DimCustomerNJ[完整地址] )
			        || TRIM ( DimCustomerNJ[完整地址] ) = "", "缺少详细地址",
			    ISBLANK ( DimCustomerNJ[城市] )
			        || TRIM ( DimCustomerNJ[城市] ) = "", "缺少城市",
			    ISBLANK ( DimCustomerNJ[省州] )
			        || TRIM ( DimCustomerNJ[省州] ) = "", "缺少州",
			    ISBLANK ( DimCustomerNJ[负责销售人员] )
			        || TRIM ( DimCustomerNJ[负责销售人员] ) = "", "缺少销售人员",
			    "可以计算路线"
			)
		lineageTag: df639dcb-ac37-42b9-b61a-1ff45c5e34a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 路线计算可用标记 =
			
			IF (
			    NOT ISBLANK ( DimCustomerNJ[客户编号] )
			        && NOT ISBLANK ( DimCustomerNJ[路线地址] )
			        && TRIM ( DimCustomerNJ[路线地址] ) <> ""
			        && NOT ISBLANK ( DimCustomerNJ[负责销售人员] )
			        && TRIM ( DimCustomerNJ[负责销售人员] ) <> "",
			    1,
			    0
			)
		lineageTag: efaf947d-c95b-4b94-b4d3-452e6c074eea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 路线地址 =
			
			TRIM ( DimCustomerNJ[完整地址] )
		lineageTag: 22204501-c7c6-4210-99ec-d6d6197176fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 路线单次服务分钟 =
			
			SWITCH (
			    DimCustomerNJ[客户类型],
			    "Wholesaler", 60,
			    "Supermarket/Grocery", 45,
			    "Retail", 35,
			    "On-Premise", 40,
			    "Pharmacy", 30,
			    "E-Commerce", 0,
			    30
			)
		formatString: 0
		lineageTag: 59e4956c-c4c5-4c72-a38e-2cb4e54e6eac
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimCustomerNJ = calculated
		mode: import
		source =
				
				VAR CustomerData =
				    FILTER (
				        FactSalesAll,
				        NOT ISBLANK ( FactSalesAll[合作伙伴/参考] )
				            && FactSalesAll[合作伙伴/参考] <> ""
				    )
				RETURN
				    SUMMARIZE (
				        CustomerData,
				        FactSalesAll[合作伙伴/参考],
				
				        "客户名称",
				            MAX ( FactSalesAll[合作伙伴] ),
				
				        "客户类型",
				            MAX ( FactSalesAll[合作伙伴/客户类型] ),
				
				        "完整地址",
				            MAX ( FactSalesAll[合作伙伴/完整地址] ),
				
				        "城市",
				            MAX ( FactSalesAll[合作伙伴/城市] ),
				
				        "省州",
				            MAX ( FactSalesAll[合作伙伴/省/州] )
				    )

	annotation PBI_Id = 74fb8766a3954789bc9bf4c94f9b4aee

