	measure 客户退货表现得分 =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[客户编号] )
			
			VAR CurrentType =
			    TRIM (
			        SELECTEDVALUE ( DimCustomerAll[客户类型], "" )
			    )
			
			VAR PositiveSales =
			    [评级正向销售额]
			
			VAR ReturnRate =
			    [评级退货率]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        -- 当前不是单一客户
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        -- 没有客户类型
			        CurrentType = "",
			            BLANK (),
			
			        -- 批发客户不计算退货得分
			        CurrentType = "Wholesaler",
			            BLANK (),
			
			        -- 没有正向销售
			        ISBLANK ( PositiveSales )
			            || PositiveSales <= 0,
			            BLANK (),
			
			        -- 按退货率评分
			        ReturnRate <= 0, 100,
			        ReturnRate <= 0.01, 90,
			        ReturnRate <= 0.03, 75,
			        ReturnRate <= 0.05, 60,
			        ReturnRate <= 0.10, 30,
			        0
			    )
		formatString: 0
		lineageTag: 770142d6-0239-4df3-acb0-7fcc830d30c6

	measure 客户综合评分 =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[客户编号] )
			
			VAR CustomerType =
			    TRIM (
			        SELECTEDVALUE ( DimCustomerAll[客户类型], "" )
			    )
			
			VAR IsWholesaler =
			    CustomerType = "Wholesaler"
			
			VAR SalesScore =
			    [客户销售额得分]
			
			VAR GrossProfitScore =
			    [客户毛利得分]
			
			VAR SKUScore =
			    [客户SKU数量得分]
			
			VAR FrequencyScore =
			    [客户购买频率得分]
			
			VAR ReturnScore =
			    [客户退货表现得分]
			
			VAR RetailComplete =
			    NOT ISBLANK ( SalesScore )
			        && NOT ISBLANK ( GrossProfitScore )
			        && NOT ISBLANK ( SKUScore )
			        && NOT ISBLANK ( FrequencyScore )
			        && NOT ISBLANK ( ReturnScore )
			
			VAR WholesaleComplete =
			    NOT ISBLANK ( SalesScore )
			        && NOT ISBLANK ( GrossProfitScore )
			        && NOT ISBLANK ( FrequencyScore )
			
			VAR RetailScore =
			    SalesScore * 0.25
			        + GrossProfitScore * 0.30
			        + SKUScore * 0.20
			        + FrequencyScore * 0.15
			        + ReturnScore * 0.10
			
			VAR WholesaleScore =
			    SalesScore * 0.40
			        + GrossProfitScore * 0.40
			        + FrequencyScore * 0.20
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        CustomerType = "",
			            BLANK (),
			
			        IsWholesaler && NOT WholesaleComplete,
			            BLANK (),
			
			        NOT IsWholesaler && NOT RetailComplete,
			            BLANK (),
			
			        IsWholesaler,
			            ROUND ( WholesaleScore, 1 ),
			
			        ROUND ( RetailScore, 1 )
			    )
		lineageTag: c5e7bb02-5f24-48b8-a0ba-0f36b6674f8d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 客户等级 =
			
			VAR CurrentCustomer =
			    SELECTEDVALUE ( DimCustomerAll[客户编号] )
			
			VAR Score =
			    [客户综合评分]
			
			VAR GrossProfit =
			    [评级毛利]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        ISBLANK ( CurrentCustomer ),
			            BLANK (),
			
			        ISBLANK ( Score ),
			            BLANK (),
			
			        ISBLANK ( GrossProfit ),
			            BLANK (),
			
			        -- 毛利不大于0，即使达到80分，最高只能是B
			        GrossProfit <= 0 && Score >= 80,
			            "B",
			
			        Score >= 80, "A",
			        Score >= 65, "B",
			        Score >= 50, "C",
			        "D"
			    )
		lineageTag: 7fe141d3-73d5-4af4-a69d-7005f8fa0847

