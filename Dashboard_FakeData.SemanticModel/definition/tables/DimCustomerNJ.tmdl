	column State
		lineageTag: a7ef3dbf-2321-43ac-96e0-fc96176e6203
		summarizeBy: none
		isNameInferred
		sourceColumn: [State]

		annotation SummarizationSetBy = Automatic

	column 'Map Address' =
			
			VAR FullAddress =
			    TRIM ( DimCustomerNJ[Full Address] )
			VAR City =
			    TRIM ( DimCustomerNJ[City] )
			VAR StateName =
			    TRIM ( DimCustomerNJ[State] )
			RETURN
			    IF (
			        FullAddress = "",
			        BLANK (),
			        IF (
			            City <> ""
			                && CONTAINSSTRING (
			                    UPPER ( FullAddress ),
			                    UPPER ( City )
			                ),
			            FullAddress & ", United States",
			            FullAddress
			                & IF ( City <> "", ", " & City, "" )
			                & IF ( StateName <> "", ", " & StateName, "" )
			                & ", United States"
			        )
			    )
		lineageTag: 3361c21f-661c-45de-b32d-ba2ca9e42a80
		dataCategory: Address
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Responsible Salesperson' =
			
			VAR CurrentCustomer =
			    DimCustomerNJ[Customer ID]
			VAR LatestCustomerRecord =
			    TOPN(
			        1,
			        FILTER(
			            ALL(FactSalesAll),
			            FactSalesAll[Partner/Reference] = CurrentCustomer
			                && NOT ISBLANK(FactSalesAll[Partner/Sales Rep])
			                && FactSalesAll[Partner/Sales Rep] <> ""
			        ),
			        FactSalesAll[Invoice/Bill Date], DESC
			    )
			RETURN
			    MAXX(
			        LatestCustomerRecord,
			        FactSalesAll[Partner/Sales Rep]
			    )
		lineageTag: e0eb6f9d-6118-4ba5-9bb4-de03fe267753
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer First Order Date' =
			
			VAR CurrentCustomer =
			    DimCustomerNJ[Customer ID]
			
			VAR FirstDateBranchCost =
			    MINX(
			        FILTER(
			            ALL(FactBranchCost),
			            FactBranchCost[customer_no] = CurrentCustomer
			        ),
			        FactBranchCost[Invoice Date]
			    )
			
			VAR FirstDateSalesAll =
			    MINX(
			        FILTER(
			            ALL(FactSalesAll),
			            FactSalesAll[Partner/Reference] = CurrentCustomer
			        ),
			        FactSalesAll[Invoice/Bill Date]
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(FirstDateBranchCost), FirstDateSalesAll,
			        ISBLANK(FirstDateSalesAll), FirstDateBranchCost,
			        MIN(FirstDateBranchCost, FirstDateSalesAll)
			    )
		formatString: General Date
		lineageTag: 566ccff6-6f83-410e-a7e5-750ba2a23774
		summarizeBy: none

		variation Variation
			isDefault
			relationship: f7d36921-c625-40a0-a44b-0279706c07fa
			defaultHierarchy: LocalDateTable_72cebef0-949b-483f-8d5b-30d0dbb027fb.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Address Usable Flag' =
			
			IF (
			    NOT ISBLANK ( DimCustomerNJ[Customer ID] )
			        && NOT ISBLANK ( DimCustomerNJ[Full Address] )
			        && NOT ISBLANK ( DimCustomerNJ[City] )
			        && NOT ISBLANK ( DimCustomerNJ[State] ),
			    1,
			    0
			)
		formatString: 0
		lineageTag: af8b97d1-4fbd-4ddc-ab62-e66d9c6f31ab
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Address Status' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( DimCustomerNJ[Full Address] ), "Missing Street Address",
			    ISBLANK ( DimCustomerNJ[City] ), "Missing City",
			    ISBLANK ( DimCustomerNJ[State] ), "Missing State",
			    "Address Complete"
			)
		lineageTag: 39e02c17-0b65-42b7-864d-eafda43f8f53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Route Data Status' =
			
			SWITCH (
			    TRUE (),
			    ISBLANK ( DimCustomerNJ[Customer ID] ), "Missing Customer ID",
			    ISBLANK ( DimCustomerNJ[Full Address] )
			        || TRIM ( DimCustomerNJ[Full Address] ) = "", "Missing Detailed Address",
			    ISBLANK ( DimCustomerNJ[City] )
			        || TRIM ( DimCustomerNJ[City] ) = "", "Missing City",
			    ISBLANK ( DimCustomerNJ[State] )
			        || TRIM ( DimCustomerNJ[State] ) = "", "Missing State",
			    ISBLANK ( DimCustomerNJ[Responsible Salesperson] )
			        || TRIM ( DimCustomerNJ[Responsible Salesperson] ) = "", "Missing Salesperson",
			    "Route Can Be Calculated"
			)
		lineageTag: df639dcb-ac37-42b9-b61a-1ff45c5e34a3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Route Calculation Usable Flag' =
			
			IF (
			    NOT ISBLANK ( DimCustomerNJ[Customer ID] )
			        && NOT ISBLANK ( DimCustomerNJ[Route Address] )
			        && TRIM ( DimCustomerNJ[Route Address] ) <> ""
			        && NOT ISBLANK ( DimCustomerNJ[Responsible Salesperson] )
			        && TRIM ( DimCustomerNJ[Responsible Salesperson] ) <> "",
			    1,
			    0
			)
		lineageTag: efaf947d-c95b-4b94-b4d3-452e6c074eea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Route Address' =
			
			TRIM ( DimCustomerNJ[Full Address] )
		lineageTag: 22204501-c7c6-4210-99ec-d6d6197176fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Route Minutes per Visit' =
			
			SWITCH (
			    DimCustomerNJ[Customer Type],
			    "Wholesaler", 60,
			    "Supermarket/Grocery", 45,
			    "Retail", 35,
			    "On-Premise", 40,
			    "Pharmacy", 30,
			    "E-Commerce", 0,
			    30
			)
		formatString: 0
		lineageTag: 59e4956c-c4c5-4c72-a38e-2cb4e54e6eac
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimCustomerNJ = calculated
		mode: import
		source =
				
				VAR CustomerData =
				    FILTER (
				        FactSalesAll,
				        NOT ISBLANK ( FactSalesAll[Partner/Reference] )
				            && FactSalesAll[Partner/Reference] <> ""
				    )
				RETURN
				    SUMMARIZE (
				        CustomerData,
				        FactSalesAll[Partner/Reference],
				
				        "Customer Name",
				            MAX ( FactSalesAll[Partner] ),
				
				        "Customer Type",
				            MAX ( FactSalesAll[Partner/Customer Type] ),
				
				        "Full Address",
				            MAX ( FactSalesAll[Partner/Full Address] ),
				
				        "City",
				            MAX ( FactSalesAll[Partner/City] ),
				
				        "State",
				            MAX ( FactSalesAll[Partner/Province/State] )
				    )

	annotation PBI_Id = 74fb8766a3954789bc9bf4c94f9b4aee

