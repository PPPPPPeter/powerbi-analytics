		sourceColumn: [年月排序]

		annotation SummarizationSetBy = Automatic

	column 年周 =
			
			YEAR(DimDate[Date]) * 100
			    + WEEKNUM(DimDate[Date], 2)
		formatString: 0
		lineageTag: dd761a44-501e-46ab-9d7d-6896662ca7cc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX(
				        ALL(FactBranchCost),
				        FactBranchCost[Invoice Date]
				    )
				VAR MaxDate =
				    MAXX(
				        ALL(FactBranchCost),
				        FactBranchCost[Invoice Date]
				    )
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(
				            DATE(YEAR(MinDate), 1, 1),
				            DATE(YEAR(MaxDate), 12, 31)
				        ),
				        "年份", YEAR([Date]),
				        "月份序号", MONTH([Date]),
				        "月份", FORMAT([Date], "MMM"),
				        "年月", FORMAT([Date], "yyyy-MM"),
				        "年月排序", YEAR([Date]) * 100 + MONTH([Date]),
				        "季度", "Q" & FORMAT([Date], "Q")
				    )

	annotation PBI_Id = 396643d11ee74d3a93afac8b0e19cbbd

