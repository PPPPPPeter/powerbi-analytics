	column 'Year Month Sort'
		formatString: 0
		lineageTag: fd855960-89da-4413-9475-45b5a08d44f9
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year Month Sort]

		annotation SummarizationSetBy = Automatic

	column 'Year Week' =
			
			YEAR(DimDate[Date]) * 100
			    + WEEKNUM(DimDate[Date], 2)
		formatString: 0
		lineageTag: dd761a44-501e-46ab-9d7d-6896662ca7cc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				VAR MinDate =
				    MINX(
				        ALL(FactBranchCost),
				        FactBranchCost[Invoice Date]
				    )
				VAR MaxDate =
				    MAXX(
				        ALL(FactBranchCost),
				        FactBranchCost[Invoice Date]
				    )
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(
				            DATE(YEAR(MinDate), 1, 1),
				            DATE(YEAR(MaxDate), 12, 31)
				        ),
				        "Year", YEAR([Date]),
				        "Month Number", MONTH([Date]),
				        "Month", FORMAT([Date], "MMM"),
				        "Year Month", FORMAT([Date], "yyyy-MM"),
				        "Year Month Sort", YEAR([Date]) * 100 + MONTH([Date]),
				        "Quarter", "Q" & FORMAT([Date], "Q")
				    )

	annotation PBI_Id = 396643d11ee74d3a93afac8b0e19cbbd

