table DimDate
	lineageTag: 195b5ca3-946d-4be1-9b81-4103c3cc6561
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 112e66ef-520f-4a3b-a82a-b4a9d4a4f27b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		formatString: 0
		lineageTag: 4941b25b-e3e5-4ab2-a8e2-332c244008eb
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

