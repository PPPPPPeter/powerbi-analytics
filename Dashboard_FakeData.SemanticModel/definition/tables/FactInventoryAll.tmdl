	partition FactInventoryAll = m
		mode: import
		source =
				let
				    Source = Excel.Workbook((if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/branch_inventory.xlsx") else File.Contents(DataRoot & "\branch_inventory.xlsx")), null, true),
				    InventoryDetail_Sheet = Source{[Item="Inventory Detail",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(InventoryDetail_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Location/Warehouse", type text}, {"Brand", type text}, {"Product/Name", type text}, {"Ref Num", type text}, {"Lot/Serial Number/Expiry Date", type date}, {"year_month", type text}, {"Quantity1", Int64.Type}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"Ref Num", "SKU"}, {"Quantity1", "Stock Qty"}, {"Location/Warehouse", "Branch Warehouse"}, {"Lot/Serial Number/Expiry Date", "Expiry Date"}}),
				    Custom1 = Table.TransformColumns(
				    #"Renamed Columns",
				    {
				        {
				            "SKU",
				            each Text.Upper(
				                Text.Trim(
				                    Text.Clean(Text.From(_))
				                )
				            ),
				            type text
				        }
				    }
				)
				in
				    Custom1

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

