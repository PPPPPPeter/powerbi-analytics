table FactInventoryAll
	lineageTag: 4d989e90-6f9a-46c6-bdd8-9e0aace5f87f

	measure 'Inventory As-of Date' =
			
			CALCULATE (
			    MAX ( FactBranchCost[Invoice Date] ),
			    REMOVEFILTERS ( DimDate ),
			    REMOVEFILTERS ( FactBranchCost[Invoice Date] )
			)
		formatString: General Date
		lineageTag: 77457e98-c62b-4f0a-beac-e83338fd1edc

	measure 'Last Month Volume' =
			
			VAR EndDate =
			    CALCULATE (
			        MAX ( FactBranchCost[Invoice Date] ),
			        REMOVEFILTERS ( DimDate )
			    )
			RETURN
			    CALCULATE (
			        SUM ( FactBranchCost[quantity] ),
			        REMOVEFILTERS ( DimDate ),
			        DATESBETWEEN (
			            DimDate[Date],
			            EndDate - 29,
			            EndDate
			        )
			    )
		lineageTag: 405a5377-2e62-48cb-b9f6-bd0c751cb405

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 3 Months Volume' =
			
			VAR EndDate =
			    CALCULATE (
			        MAX ( FactBranchCost[Invoice Date] ),
			        REMOVEFILTERS ( DimDate )
			    )
			RETURN
			    CALCULATE (
			        SUM ( FactBranchCost[quantity] ),
			        REMOVEFILTERS ( DimDate ),
			        DATESBETWEEN (
			            DimDate[Date],
			            EDATE ( EndDate, -3 ) + 1,
			            EndDate
			        )
			    )
		lineageTag: 3994c3d9-6aa1-4134-b7ae-948201aba737

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 30 Days Sales Qty' =
			
			VAR EndDate =
			    [Inventory As-of Date]
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			
			RETURN
			    CALCULATE (
			        SUM ( FactBranchCost[quantity] ),
			        REMOVEFILTERS ( DimDate ),
			        DATESBETWEEN (
			            DimDate[Date],
			            EndDate - 29,
			            EndDate
			        ),
			        TREATAS (
			            SelectedSKUs,
			            FactBranchCost[Ref Num]
			        )
			    )
		lineageTag: d6f1ccc1-4f71-4986-a6e6-22023cbc411a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 90 Days Sales Qty' =
			
			VAR EndDate =
			    [Inventory As-of Date]
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			
			RETURN
			    CALCULATE (
			        SUM ( FactBranchCost[quantity] ),
			        REMOVEFILTERS ( DimDate ),
			        DATESBETWEEN (
			            DimDate[Date],
			            EndDate - 89,
			            EndDate
			        ),
			        TREATAS (
			            SelectedSKUs,
			            FactBranchCost[Ref Num]
			        )
			    )
		lineageTag: 0942f08c-4b11-40f9-8721-39ba631ff8d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

