	measure 总销售完成率 =
			
			VAR TotalActual =
			    CALCULATE(
			        [订单创建人销售额],
			        REMOVEFILTERS(DimSalesperson),
			        REMOVEFILTERS(DimCreator)
			    )
			VAR TotalTarget =
			    CALCULATE(
			        SUM(FactSalesTarget[KPI目标]),
			        REMOVEFILTERS(DimSalesperson),
			        REMOVEFILTERS(DimCreator)
			    )
			RETURN
			    DIVIDE(
			        TotalActual,
			        TotalTarget,
			        0
			    )
		lineageTag: 7acfb594-1bbb-487f-a78a-f6ec6fd06683

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Sale' =
			
			VAR SalesTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(DimCreator[订单创建人]),
			            NOT ISBLANK(DimCreator[订单创建人])
			                && DimCreator[订单创建人] <> "未知人员"
			        ),
			        "@SalesAmount", [订单创建人销售额]
			    )
			VAR TopPerson =
			    TOPN(
			        1,
			        SalesTable,
			        [@SalesAmount], DESC,
			        DimCreator[订单创建人], ASC
			    )
			RETURN
			    CONCATENATEX(
			        TopPerson,
			        DimCreator[订单创建人],
			        ""
			    )
		lineageTag: 3bfa9fe4-69df-4b4c-a102-27de9616425d

	measure 总销售额距离目标 =
			
			VAR TotalActual =
			    CALCULATE (
			        [订单创建人销售额],
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR TotalTarget =
			    CALCULATE (
			        SUM ( FactSalesTarget[KPI目标] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			RETURN
			    ABS ( TotalTarget - TotalActual )
		lineageTag: 0526d93f-0d44-410a-a860-f51dc3944fea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Sale 占比' =
			
			VAR SalesTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(DimCreator[订单创建人]),
			            NOT ISBLANK(DimCreator[订单创建人])
			                && DimCreator[订单创建人] <> "未知人员"
			        ),
			        "@SalesAmount", [订单创建人销售额]
			    )
			VAR TopSalesAmount =
			    MAXX(
			        SalesTable,
			        [@SalesAmount]
			    )
			VAR TotalSalesAmount =
			    CALCULATE(
			        [订单创建人销售额],
			        ALLSELECTED(DimCreator[订单创建人])
			    )
			RETURN
			    DIVIDE(
			        TopSalesAmount,
			        TotalSalesAmount,
			        0
			    )
		lineageTag: d3a98861-0892-46e7-8bb2-d4680900800d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 选定年份销售额 =
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[年份])
			RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        CALCULATE(
			            [订单创建人销售额],
			            REMOVEFILTERS(DimDate),
			            DimDate[年份] = SelectedYear
			        )
			    )
		lineageTag: b98ca89d-5c42-4f87-a0da-2f63a1c929b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 上年同期销售额 =
			
			CALCULATE(
			    [订单创建人销售额],
			    SAMEPERIODLASTYEAR(DimDate[Date])
			)
		lineageTag: 6ee401e8-9c57-4683-8cdf-87529296f18a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 往年同期同比 =
			
			VAR CurrentSales =
			    [订单创建人销售额]
			VAR PreviousYearSales =
			    [上年同期销售额]
			RETURN
			    IF(
			        ISBLANK(PreviousYearSales)
			            || PreviousYearSales = 0,
			        BLANK(),
			        DIVIDE(
			            CurrentSales - PreviousYearSales,
			            PreviousYearSales
			        )
			    )
		lineageTag: be4a427a-016f-478a-b3d6-c7b07e773ff5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 品牌销售占比 =
			
			DIVIDE(
			    [分公司销售额（不含运费和服务费）],
			    CALCULATE(
			        [分公司销售额（不含运费和服务费）],
			        REMOVEFILTERS(ProductCatalogAll[品牌])
			    ),
			    0
			)
		lineageTag: 5082d686-d1ef-456a-a522-5a7a64eae0bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 上月销售额 =
			
			CALCULATE(
			    [订单创建人销售额],
			    DATEADD(
			        DimDate[Date],
			        -1,
			        MONTH
			    )
			)
		lineageTag: e2579bb1-88d3-4a07-8844-d1a8025a73c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 月环比 =
			
			DIVIDE(
			    [订单创建人销售额] - [上月销售额],
			    [上月销售额],
			    0
			)
		lineageTag: 79871ea4-823d-486d-8ce0-d8e50fd3430d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 销售额（不含运费和服务费） =
			
			CALCULATE (
			    SUMX (
			        FactSalesAll,
			        VAR InvoiceType =
			            FactSalesAll[Type]
			        VAR LineSubtotal =
			            FactSalesAll[小计]
			        RETURN
			            SWITCH (
			                InvoiceType,
			                "out_invoice", LineSubtotal,
			                "out_refund", -ABS ( LineSubtotal ),
			                BLANK ()
			            )
			    ),
			
			    KEEPFILTERS (
			        NOT (
			            FactSalesAll[产品/内部参考号]
			                IN { "SHH", "Service Fee", "RDC", "C-1" }
			        )
			    )
			)
		lineageTag: 75930800-96dd-4062-a461-b925daa4bd6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 总销售额距离目标颜色 =
			
			VAR TotalActual =
			    CALCULATE (
			        [订单创建人销售额],
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR TotalTarget =
			    CALCULATE (
			        SUM ( FactSalesTarget[KPI目标]),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			RETURN
			    IF (
			        TotalActual >= TotalTarget,
			        "#2E8B57",   -- 达到或超过目标：绿色
			        "#C94C4C"    -- 尚未达到目标：红色
			    )
		formatString: 0
		lineageTag: 11388750-5dde-474b-8a40-d10b93e878e0

	measure 销售完成度Gauge颜色 =
			
			VAR ActualSales =
			    [订单创建人销售额]
			
			VAR AugustTarget =
			    SUM ( FactSalesTarget[KPI目标] )
			
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AugustTarget ) || AugustTarget <= 0, "#9E9E9E",
			        ActualSales >= AugustTarget, "#2E8B57",  -- 绿色
			        "#C94C4C"                              -- 红色
			    )
		formatString: 0
		lineageTag: eb7d093f-d8b2-4b65-8082-3e394e3e85e9

	measure 销售完成率颜色 =
			
			IF (
			    [总销售完成率] >= 1,
			    "#2E8B57",   -- ≥100%：绿色
			    "#C94C4C"    -- <100%：红色
			)
		lineageTag: a45a1ba6-d175-4bfe-8bbf-595e63b7709a

	measure 往年同比颜色 =
			
			IF (
			    [往年同期同比] >= 0,
			    "#2E8B57",   -- ≥0%：绿色
			    "#C94C4C"    -- <0%：红色
			)
		lineageTag: 337852f1-2aa7-44d3-8e48-ddef18dd9869

	measure 冰淇淋销售额 =
			
