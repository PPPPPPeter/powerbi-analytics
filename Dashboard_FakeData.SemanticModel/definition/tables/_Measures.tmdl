	measure 'MoM Color' =
			
			VAR MoM =
			    [MoM]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(MoM), "#808080",
			        MoM > 0, "#2E7D32",
			        MoM < 0, "#C62828",
			        "#808080"
			    )
		lineageTag: 14e1b3e5-a79c-4360-80d5-c8b385d58065

	measure 'Ice Cream Completion Label' =
			
			VAR Rate = [Ice Cream Completion Rate]
			RETURN
			    "Ice Cream Completion: " &
			    IF(ISBLANK(Rate), "—", FORMAT(Rate, "0.0%"))
		lineageTag: 5c8e8447-21e1-49d6-bfec-d1318c7374ae

