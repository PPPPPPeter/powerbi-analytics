	measure 月环比颜色 =
			
			VAR MoM =
			    [月环比]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(MoM), "#808080",
			        MoM > 0, "#2E7D32",
			        MoM < 0, "#C62828",
			        "#808080"
			    )
		lineageTag: 14e1b3e5-a79c-4360-80d5-c8b385d58065

