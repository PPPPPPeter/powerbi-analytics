	measure 品牌毛利贡献占比 =
			
			DIVIDE (
			    [产品价格_毛利],
			    CALCULATE (
			        [产品价格_毛利],
			        REMOVEFILTERS ( ProductCatalogAll[品牌] )
			    ),
			    0
			)
		lineageTag: 92345dcb-5860-41d1-ab2c-11777391c673

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SKU主要供应商 =
			
			VAR SupplierTable =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( FactPurchaseLeadTime[供应商] ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[供应商]
			            )
			        ),
			        "@OrderCount",
			            CALCULATE ( [提前期有效样本数] )
			    )
			
			VAR TopSupplier =
			    TOPN (
			        1,
			        SupplierTable,
			        [@OrderCount], DESC,
			        FactPurchaseLeadTime[供应商], ASC
			    )
			
			RETURN
			    CONCATENATEX (
			        TopSupplier,
			        FactPurchaseLeadTime[供应商],
			        ""
			    )
		lineageTag: 65d6c1be-1b77-43ef-8495-de641eb6caf4

	measure SKU主要供应商样本数 =
			
			VAR MainSupplier =
			    [SKU主要供应商]
			
			RETURN
			    IF (
			        NOT ISBLANK ( MainSupplier ),
			        CALCULATE (
			            [提前期有效样本数],
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[供应商]
			            ),
			            TREATAS (
			                { MainSupplier },
			                FactPurchaseLeadTime[供应商]
			            )
			        )
			    )
		formatString: 0
		lineageTag: 0bb410d9-f3aa-45d0-b850-c9330af86ad2

	measure SKU主要供应商P80 =
			
			VAR MainSupplier =
			    [SKU主要供应商]
			
			RETURN
			    IF (
			        NOT ISBLANK ( MainSupplier ),
			        CALCULATE (
			            [实际提前期P80],
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[供应商]
			            ),
			            TREATAS (
			                { MainSupplier },
			                FactPurchaseLeadTime[供应商]
			            )
			        )
			    )
		lineageTag: 0be6b0e8-73bf-4f98-9eec-381946df8461

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SKU补货提前期 =
			
			VAR SKUSamples =
			    [SKU提前期样本数]
			
			VAR SKULeadTime =
			    [SKU实际提前期P80]
			
			VAR MainSupplierSamples =
			    [SKU主要供应商样本数]
			
			VAR MainSupplierLeadTime =
			    [SKU主要供应商P80]
			
			VAR CompanyLeadTime =
			    [公司整体实际提前期P80]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        SKUSamples >= 5
			            && NOT ISBLANK ( SKULeadTime ),
			            SKULeadTime,
			
			        MainSupplierSamples >= 5
			            && NOT ISBLANK ( MainSupplierLeadTime ),
			            MainSupplierLeadTime,
			
			        NOT ISBLANK ( CompanyLeadTime ),
			            CompanyLeadTime,
			
			        14
			    )
		lineageTag: 68101257-cd2b-498c-ac82-fae4ef409307

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 铺货分析_在手数量 =
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			RETURN
			    CALCULATE (
			        SUM ( FactInventoryLot[在手数量] ),
			
			        -- 避免另一个产品维度与当前SKU产生交叉干扰
			        REMOVEFILTERS ( DimProductAll ),
			
			        TREATAS (
			            SelectedSKUs,
			            FactInventoryLot[产品/内部参考号]
			        )
			    )
		formatString: 0
		lineageTag: 6af45c84-a59e-4a77-bd2f-a537729f5aa2

	measure 铺货分析_本期销售额 =
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			RETURN
			    CALCULATE (
			        [分公司销售额（不含运费和服务费）],
			
			        KEEPFILTERS (
			            TREATAS (
			                SelectedSKUs,
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5419fe2e-967d-4ef1-9d35-11e9caedc659

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 铺货分析_库存SKU标记 =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [铺货分析_在手数量], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: d13971a0-221b-434e-9abe-3f58b7130876

	measure 铺货分析_已铺货SKU标记 =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [铺货分析_在手数量], 0 )
			
			VAR CurrentSales =
			    COALESCE ( [铺货分析_本期销售额], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0
			            && CurrentSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 02b1c516-8784-4927-b967-195c861d037f

	measure 铺货分析_未铺货SKU标记 =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [铺货分析_在手数量], 0 )
			
			VAR CurrentSales =
			    COALESCE ( [铺货分析_本期销售额], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0
			            && CurrentSales <= 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: df070885-a902-4792-aa3e-55ff69fc5b35

	measure 铺货分析_库存SKU总数 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [铺货分析_库存SKU标记] = 1
			    )
			)
		formatString: 0
		lineageTag: e423c472-df94-4ba8-acbd-4c45f6756048

	measure 铺货分析_已铺货SKU数量 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [铺货分析_已铺货SKU标记] = 1
			    )
			)
		formatString: 0
		lineageTag: a5c94de9-8236-4a9e-9852-313f9537d87d

	measure 铺货分析_未铺货SKU数量 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [铺货分析_未铺货SKU标记] = 1
			    )
			)
		formatString: 0
		lineageTag: 2cc3bfdc-70cf-41ca-95fe-2e79607c98dd

	measure 铺货分析_SKU数量核对 =
			
			VAR TotalSKU =
			    [铺货分析_库存SKU总数]
			
			VAR StockedSKU =
			    [铺货分析_已铺货SKU数量]
			
			VAR UnstockedSKU =
			    [铺货分析_未铺货SKU数量]
			
			RETURN
			    TotalSKU - StockedSKU - UnstockedSKU
		formatString: 0
		lineageTag: 787dd2bb-0196-4d91-9562-e5268bd1012e

	measure 品牌客户_客户本期总销售额 =
			
			CALCULATE (
			    [分公司销售额（不含运费和服务费）],
			
			    REMOVEFILTERS ( ProductCatalogAll ),
			    REMOVEFILTERS ( ProductCatalog ),
			    REMOVEFILTERS ( DimProductAll ),
			
			    REMOVEFILTERS (
			        FactBranchCost[brand_cn_name],
			        FactBranchCost[brand_name],
			        FactBranchCost[Ref Num],
			        FactBranchCost[product_name]
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 55e9b64f-7876-418a-aa40-84349e576508

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 品牌客户_所选品牌有库存SKU数 =
			
			IF (
			    HASONEVALUE ( ProductCatalogAll[品牌] ),
			    [铺货分析_库存SKU总数],
			    BLANK ()
			)
		formatString: 0
		lineageTag: d203f764-65b4-44b0-a406-5a2cab56fe43

	measure 品牌客户_所选品牌本期销售额 =
			
			VAR HasOneBrand =
			    HASONEVALUE ( ProductCatalogAll[品牌] )
			
			VAR InStockSKUs =
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [铺货分析_库存SKU标记] = 1
			    )
			
			RETURN
			    IF (
			        NOT HasOneBrand,
			        BLANK (),
			        CALCULATE (
			            [分公司销售额（不含运费和服务费）],
			
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS ( ProductCatalog ),
			            REMOVEFILTERS ( DimProductAll ),
			
			            REMOVEFILTERS (
			                FactBranchCost[brand_cn_name],
			                FactBranchCost[brand_name],
			                FactBranchCost[Ref Num],
			                FactBranchCost[product_name]
			            ),
			
			            TREATAS (
			                InStockSKUs,
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: fde457cc-9e81-4015-89ee-bd8d9f66e6e2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 品牌客户_目标客户标记 =
			
			VAR CurrentCustomerKey =
			    SELECTEDVALUE ( DimCustomerAll[客户公司Key] )
			
			VAR AvailableSKUCount =
			    COALESCE ( [品牌客户_所选品牌有库存SKU数], 0 )
			
			VAR CustomerTotalSales =
			    COALESCE ( [品牌客户_客户本期总销售额], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentCustomerKey )
			            && HASONEVALUE ( ProductCatalogAll[品牌] )
			            && AvailableSKUCount > 0
			            && CustomerTotalSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 94413e27-5f20-420d-b672-f054955ac44c

	measure 品牌客户_已铺货客户标记 =
			
			VAR IsTargetCustomer =
			    [品牌客户_目标客户标记]
			
			VAR BrandSales =
			    COALESCE ( [品牌客户_所选品牌本期销售额], 0 )
			
			RETURN
			    IF (
			        IsTargetCustomer = 1
			            && BrandSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 5404080e-61b8-4110-873d-dd35b94813cb

	measure 品牌客户_目标客户数 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimCustomerAll[客户公司Key] ),
			        [品牌客户_目标客户标记] = 1
			    )
			)
		formatString: 0
		lineageTag: 203beab9-816b-47f9-af98-c2cc52101834

	measure 品牌客户_已铺货客户数 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimCustomerAll[客户公司Key] ),
			        [品牌客户_已铺货客户标记] = 1
			    )
			)
		formatString: 0
		lineageTag: 4776429c-e32f-4d90-ac57-f905242e48e3

	measure 品牌客户_未铺货客户数 =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimCustomerAll[客户公司Key] ),
			        [品牌客户_已铺货客户标记] = 0
			    )
			)
		formatString: 0
		lineageTag: e0f001c0-1647-480b-9604-7a8e0407a356

	measure 品牌客户_铺货率 =
			
			DIVIDE (
			    [品牌客户_已铺货客户数],
			    [品牌客户_目标客户数],
			    0
			)
		lineageTag: 981cf156-2dc8-4c86-b85b-d4e3454fa4b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

