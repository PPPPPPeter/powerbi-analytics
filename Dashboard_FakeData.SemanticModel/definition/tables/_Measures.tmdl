	measure 'SKU Main Supplier' =
			
			VAR SupplierTable =
			    ADDCOLUMNS (
			        CALCULATETABLE (
			            VALUES ( FactPurchaseLeadTime[Supplier] ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[Supplier]
			            )
			        ),
			        "@OrderCount",
			            CALCULATE ( [Valid Lead Time Samples] )
			    )
			
			VAR TopSupplier =
			    TOPN (
			        1,
			        SupplierTable,
			        [@OrderCount], DESC,
			        FactPurchaseLeadTime[Supplier], ASC
			    )
			
			RETURN
			    CONCATENATEX (
			        TopSupplier,
			        FactPurchaseLeadTime[Supplier],
			        ""
			    )
		lineageTag: 65d6c1be-1b77-43ef-8495-de641eb6caf4

	measure 'SKU Main Supplier Samples' =
			
			VAR MainSupplier =
			    [SKU Main Supplier]
			
			RETURN
			    IF (
			        NOT ISBLANK ( MainSupplier ),
			        CALCULATE (
			            [Valid Lead Time Samples],
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[Supplier]
			            ),
			            TREATAS (
			                { MainSupplier },
			                FactPurchaseLeadTime[Supplier]
			            )
			        )
			    )
		formatString: 0
		lineageTag: 0bb410d9-f3aa-45d0-b850-c9330af86ad2

	measure 'SKU Main Supplier P80' =
			
			VAR MainSupplier =
			    [SKU Main Supplier]
			
			RETURN
			    IF (
			        NOT ISBLANK ( MainSupplier ),
			        CALCULATE (
			            [Actual Lead Time P80],
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS (
			                FactPurchaseLeadTime[Supplier]
			            ),
			            TREATAS (
			                { MainSupplier },
			                FactPurchaseLeadTime[Supplier]
			            )
			        )
			    )
		lineageTag: 0be6b0e8-73bf-4f98-9eec-381946df8461

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SKU Reorder Lead Time' =
			
			VAR SKUSamples =
			    [SKU Lead Time Samples]
			
			VAR SKULeadTime =
			    [SKU Actual Lead Time P80]
			
			VAR MainSupplierSamples =
			    [SKU Main Supplier Samples]
			
			VAR MainSupplierLeadTime =
			    [SKU Main Supplier P80]
			
			VAR CompanyLeadTime =
			    [Company Actual Lead Time P80]
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        SKUSamples >= 5
			            && NOT ISBLANK ( SKULeadTime ),
			            SKULeadTime,
			
			        MainSupplierSamples >= 5
			            && NOT ISBLANK ( MainSupplierLeadTime ),
			            MainSupplierLeadTime,
			
			        NOT ISBLANK ( CompanyLeadTime ),
			            CompanyLeadTime,
			
			        14
			    )
		lineageTag: 68101257-cd2b-498c-ac82-fae4ef409307

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Distribution Analysis_On Hand Qty' =
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			RETURN
			    CALCULATE (
			        SUM ( FactInventoryLot[On Hand Qty] ),
			
			        -- prevent another product dimension from interfering with the current SKU
			        REMOVEFILTERS ( DimProductAll ),
			
			        TREATAS (
			            SelectedSKUs,
			            FactInventoryLot[Product/Internal Reference]
			        )
			    )
		formatString: 0
		lineageTag: 6af45c84-a59e-4a77-bd2f-a537729f5aa2

	measure 'Distribution Analysis_Current Period Sales' =
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			RETURN
			    CALCULATE (
			        [Branch Sales (Excl Freight and Service Fees)],
			
			        KEEPFILTERS (
			            TREATAS (
			                SelectedSKUs,
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5419fe2e-967d-4ef1-9d35-11e9caedc659

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Distribution Analysis_Stock SKU Flag' =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [Distribution Analysis_On Hand Qty], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: d13971a0-221b-434e-9abe-3f58b7130876

	measure 'Distribution Analysis_Distributed SKU Flag' =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [Distribution Analysis_On Hand Qty], 0 )
			
			VAR CurrentSales =
			    COALESCE ( [Distribution Analysis_Current Period Sales], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0
			            && CurrentSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 02b1c516-8784-4927-b967-195c861d037f

	measure 'Distribution Analysis_Undistributed SKU Flag' =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( ProductCatalogAll[SKU] )
			
			VAR InventoryQty =
			    COALESCE ( [Distribution Analysis_On Hand Qty], 0 )
			
			VAR CurrentSales =
			    COALESCE ( [Distribution Analysis_Current Period Sales], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && InventoryQty <> 0
			            && CurrentSales <= 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: df070885-a902-4792-aa3e-55ff69fc5b35

	measure 'Distribution Analysis_Stock SKU Total' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Distribution Analysis_Stock SKU Flag] = 1
			    )
			)
		formatString: 0
		lineageTag: e423c472-df94-4ba8-acbd-4c45f6756048

	measure 'Distribution Analysis_Distributed SKU Qty' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Distribution Analysis_Distributed SKU Flag] = 1
			    )
			)
		formatString: 0
		lineageTag: a5c94de9-8236-4a9e-9852-313f9537d87d

	measure 'Distribution Analysis_Undistributed SKU Qty' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Distribution Analysis_Undistributed SKU Flag] = 1
			    )
			)
		formatString: 0
		lineageTag: 2cc3bfdc-70cf-41ca-95fe-2e79607c98dd

	measure 'Distribution Analysis_SKU Qty Check' =
			
			VAR TotalSKU =
			    [Distribution Analysis_Stock SKU Total]
			
			VAR StockedSKU =
			    [Distribution Analysis_Distributed SKU Qty]
			
			VAR UnstockedSKU =
			    [Distribution Analysis_Undistributed SKU Qty]
			
			RETURN
			    TotalSKU - StockedSKU - UnstockedSKU
		formatString: 0
		lineageTag: 787dd2bb-0196-4d91-9562-e5268bd1012e

	measure 'Brand Customer_Customer Current Period Sales' =
			
			CALCULATE (
			    [Branch Sales (Excl Freight and Service Fees)],
			
			    REMOVEFILTERS ( ProductCatalogAll ),
			    REMOVEFILTERS ( ProductCatalog ),
			    REMOVEFILTERS ( DimProductAll ),
			
			    REMOVEFILTERS (
			        FactBranchCost[brand_cn_name],
			        FactBranchCost[brand_name],
			        FactBranchCost[Ref Num],
			        FactBranchCost[product_name]
			    )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 55e9b64f-7876-418a-aa40-84349e576508

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Brand Customer_Selected Brand In-Stock SKUs' =
			
			IF (
			    HASONEVALUE ( ProductCatalogAll[Brand] ),
			    [Distribution Analysis_Stock SKU Total],
			    BLANK ()
			)
		formatString: 0
		lineageTag: d203f764-65b4-44b0-a406-5a2cab56fe43

	measure 'Brand Customer_Selected Brand Current Period Sales' =
			
			VAR HasOneBrand =
			    HASONEVALUE ( ProductCatalogAll[Brand] )
			
			VAR InStockSKUs =
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Distribution Analysis_Stock SKU Flag] = 1
			    )
			
			RETURN
			    IF (
			        NOT HasOneBrand,
			        BLANK (),
			        CALCULATE (
			            [Branch Sales (Excl Freight and Service Fees)],
			
			            REMOVEFILTERS ( ProductCatalogAll ),
			            REMOVEFILTERS ( ProductCatalog ),
			            REMOVEFILTERS ( DimProductAll ),
			
			            REMOVEFILTERS (
			                FactBranchCost[brand_cn_name],
			                FactBranchCost[brand_name],
			                FactBranchCost[Ref Num],
			                FactBranchCost[product_name]
			            ),
			
			            TREATAS (
			                InStockSKUs,
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: fde457cc-9e81-4015-89ee-bd8d9f66e6e2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Brand Customer_Target Customer Flag' =
			
			VAR CurrentCustomerKey =
			    SELECTEDVALUE ( DimCustomerAll[Customer Company Key] )
			
			VAR AvailableSKUCount =
			    COALESCE ( [Brand Customer_Selected Brand In-Stock SKUs], 0 )
			
			VAR CustomerTotalSales =
			    COALESCE ( [Brand Customer_Customer Current Period Sales], 0 )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentCustomerKey )
			            && HASONEVALUE ( ProductCatalogAll[Brand] )
			            && AvailableSKUCount > 0
			            && CustomerTotalSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 94413e27-5f20-420d-b672-f054955ac44c

	measure 'Brand Customer_Distributed Customer Flag' =
			
			VAR IsTargetCustomer =
			    [Brand Customer_Target Customer Flag]
			
			VAR BrandSales =
			    COALESCE ( [Brand Customer_Selected Brand Current Period Sales], 0 )
			
			RETURN
			    IF (
			        IsTargetCustomer = 1
			            && BrandSales > 0,
			        1,
			        BLANK ()
			    )
		formatString: 0
		lineageTag: 5404080e-61b8-4110-873d-dd35b94813cb

	measure 'Brand Customer_Target Customers' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimCustomerAll[Customer Company Key] ),
			        [Brand Customer_Target Customer Flag] = 1
