	measure 'Brand Gross Profit Contribution Share' =
			
			DIVIDE (
			    [Product Price_Gross Profit],
			    CALCULATE (
			        [Product Price_Gross Profit],
			        REMOVEFILTERS ( ProductCatalogAll[Brand] )
			    ),
			    0
			)
		lineageTag: 92345dcb-5860-41d1-ab2c-11777391c673

