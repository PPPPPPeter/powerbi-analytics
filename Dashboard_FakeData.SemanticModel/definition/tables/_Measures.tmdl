			    REMOVEFILTERS ( DimProductAll ),
			    DimProductAll[Product Class] = "Ice Cream"
			)
		lineageTag: 9df694da-ade9-4ed6-bfda-4d85562fc565

	measure 'Ice Cream Completion Rate' =
			
