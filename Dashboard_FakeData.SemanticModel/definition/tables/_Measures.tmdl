	measure 'Total Sales Completion Rate' =
			
			VAR TotalActual =
			    CALCULATE(
			        [Order Creator Sales],
			        REMOVEFILTERS(DimSalesperson),
			        REMOVEFILTERS(DimCreator)
			    )
			VAR TotalTarget =
			    CALCULATE(
			        SUM(FactSalesTarget[KPI Target]),
			        REMOVEFILTERS(DimSalesperson),
			        REMOVEFILTERS(DimCreator)
			    )
			RETURN
			    DIVIDE(
			        TotalActual,
			        TotalTarget,
			        0
			    )
		lineageTag: 7acfb594-1bbb-487f-a78a-f6ec6fd06683

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Sale' =
			
			VAR SalesTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(DimCreator[Order Creator]),
			            NOT ISBLANK(DimCreator[Order Creator])
			                && DimCreator[Order Creator] <> "Unknown Person"
			        ),
			        "@SalesAmount", [Order Creator Sales]
			    )
			VAR TopPerson =
			    TOPN(
			        1,
			        SalesTable,
			        [@SalesAmount], DESC,
			        DimCreator[Order Creator], ASC
			    )
			RETURN
			    CONCATENATEX(
			        TopPerson,
			        DimCreator[Order Creator],
			        ""
			    )
		lineageTag: 3bfa9fe4-69df-4b4c-a102-27de9616425d

	measure 'Total Sales Gap to Target' =
			
			VAR TotalActual =
			    CALCULATE (
			        [Order Creator Sales],
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR TotalTarget =
			    CALCULATE (
			        SUM ( FactSalesTarget[KPI Target] ),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			RETURN
			    ABS ( TotalTarget - TotalActual )
		lineageTag: 0526d93f-0d44-410a-a860-f51dc3944fea

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Sale Share' =
			
			VAR SalesTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(DimCreator[Order Creator]),
			            NOT ISBLANK(DimCreator[Order Creator])
			                && DimCreator[Order Creator] <> "Unknown Person"
			        ),
			        "@SalesAmount", [Order Creator Sales]
			    )
			VAR TopSalesAmount =
			    MAXX(
			        SalesTable,
			        [@SalesAmount]
			    )
			VAR TotalSalesAmount =
			    CALCULATE(
			        [Order Creator Sales],
			        ALLSELECTED(DimCreator[Order Creator])
			    )
			RETURN
			    DIVIDE(
			        TopSalesAmount,
			        TotalSalesAmount,
			        0
			    )
		lineageTag: d3a98861-0892-46e7-8bb2-d4680900800d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Year Sales' =
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[Year])
			RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        CALCULATE(
			            [Order Creator Sales],
			            REMOVEFILTERS(DimDate),
			            DimDate[Year] = SelectedYear
			        )
			    )
		lineageTag: b98ca89d-5c42-4f87-a0da-2f63a1c929b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Year Same Period Sales' =
			
			CALCULATE(
			    [Order Creator Sales],
			    SAMEPERIODLASTYEAR(DimDate[Date])
			)
		lineageTag: 6ee401e8-9c57-4683-8cdf-87529296f18a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prior Year Same Period YoY' =
			
			VAR CurrentSales =
			    [Order Creator Sales]
			VAR PreviousYearSales =
			    [Last Year Same Period Sales]
			RETURN
			    IF(
			        ISBLANK(PreviousYearSales)
			            || PreviousYearSales = 0,
			        BLANK(),
			        DIVIDE(
			            CurrentSales - PreviousYearSales,
			            PreviousYearSales
			        )
			    )
		lineageTag: be4a427a-016f-478a-b3d6-c7b07e773ff5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brand Sales Share' =
			
			DIVIDE(
			    [Branch Sales (Excl Freight and Service Fees)],
			    CALCULATE(
			        [Branch Sales (Excl Freight and Service Fees)],
			        REMOVEFILTERS(ProductCatalogAll[Brand])
			    ),
			    0
			)
		lineageTag: 5082d686-d1ef-456a-a522-5a7a64eae0bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Month Sales' =
			
			CALCULATE(
			    [Order Creator Sales],
			    DATEADD(
			        DimDate[Date],
			        -1,
			        MONTH
			    )
			)
		lineageTag: e2579bb1-88d3-4a07-8844-d1a8025a73c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MoM =
			
			DIVIDE(
			    [Order Creator Sales] - [Last Month Sales],
			    [Last Month Sales],
			    0
			)
		lineageTag: 79871ea4-823d-486d-8ce0-d8e50fd3430d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales (Excl Freight and Service Fees)' =
			
			CALCULATE (
			    SUMX (
			        FactSalesAll,
			        VAR InvoiceType =
			            FactSalesAll[Type]
			        VAR LineSubtotal =
			            FactSalesAll[Subtotal]
			        RETURN
			            SWITCH (
			                InvoiceType,
			                "out_invoice", LineSubtotal,
			                "out_refund", -ABS ( LineSubtotal ),
			                BLANK ()
			            )
			    ),
			
			    KEEPFILTERS (
			        NOT (
			            FactSalesAll[Product/Internal Reference]
			                IN { "SHH", "Service Fee", "RDC", "C-1" }
			        )
			    )
			)
		lineageTag: 75930800-96dd-4062-a461-b925daa4bd6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales Gap Color' =
			
			VAR TotalActual =
			    CALCULATE (
			        [Order Creator Sales],
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			VAR TotalTarget =
			    CALCULATE (
			        SUM ( FactSalesTarget[KPI Target]),
			        REMOVEFILTERS ( DimSalesperson ),
			        REMOVEFILTERS ( DimCreator )
			    )
			
			RETURN
			    IF (
			        TotalActual >= TotalTarget,
			        "#2E8B57",   -- At or above target: green
			        "#C94C4C"    -- Below target: red
			    )
		formatString: 0
		lineageTag: 11388750-5dde-474b-8a40-d10b93e878e0

	measure 'Sales Completion Gauge Color' =
			
			VAR ActualSales =
			    [Order Creator Sales]
			
			VAR AugustTarget =
			    SUM ( FactSalesTarget[KPI Target] )
			
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( AugustTarget ) || AugustTarget <= 0, "#9E9E9E",
			        ActualSales >= AugustTarget, "#2E8B57",  -- Green
			        "#C94C4C"                              -- Red
			    )
		formatString: 0
		lineageTag: eb7d093f-d8b2-4b65-8082-3e394e3e85e9

	measure 'Sales Completion Color' =
			
			IF (
			    [Total Sales Completion Rate] >= 1,
			    "#2E8B57",   -- ≥100%: Green
			    "#C94C4C"    -- <100%: Red
			)
		lineageTag: a45a1ba6-d175-4bfe-8bbf-595e63b7709a

	measure 'Prior Year YoY Color' =
			
			IF (
			    [Prior Year Same Period YoY] >= 0,
			    "#2E8B57",   -- ≥0%: Green
			    "#C94C4C"    -- <0%: Red
			)
		lineageTag: 337852f1-2aa7-44d3-8e48-ddef18dd9869

	measure 'Ice Cream Sales' =
			
