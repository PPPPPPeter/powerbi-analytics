table DimCompany
	lineageTag: b0f859d7-ec78-473c-a2ff-353273394b90

	column Company
		lineageTag: d0222e2c-6e4b-4572-a44b-b397f567611d
		summarizeBy: none
		isNameInferred
		sourceColumn: [Company]

		annotation SummarizationSetBy = Automatic

	partition DimCompany = calculated
		mode: import
		source =
				
				DISTINCT (
				    UNION (
				        SELECTCOLUMNS (
				            FactBranchCost,
				            "Company", FactBranchCost[company]
				        ),
				        SELECTCOLUMNS (
				            FactInventoryLot,
				            "Company", FactInventoryLot[Company]
				        ),
				        SELECTCOLUMNS (
				            FactPurchaseOrder,
				            "Company", FactPurchaseOrder[Order Line/Company]
				        )
				    )
				)

	annotation PBI_Id = c2149cb8cdac4e9c87c209280fba1a0b

