	column 会计科目/类型
		dataType: string
		lineageTag: 1769e0ea-ab07-4f0c-b5a3-593239465771
		summarizeBy: none
		sourceColumn: 会计科目/类型

		annotation SummarizationSetBy = Automatic

	column 客户渠道 =
			
			VAR SalespersonName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactSalesAll[销售订单行/创建人],
			                ""
			            )
			        )
			    )
			VAR CustomerName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactSalesAll[合作伙伴],
			                ""
			            )
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        SalespersonName = "MAINSTREAM", "主流",
			        CustomerName IN {
			            "Harbor Spice Co",
			            "Summit Seasoning, LLC"
			        }, "代理",
			        "亚裔"
			    )
		lineageTag: 9f934f39-82d2-4b8e-8eab-64b657cd6269
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 数量_1
		dataType: double
