		sourceColumn: 数量_1

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition FactSalesAll = m
		mode: import
		source =
				let
				    Source = Csv.Document((if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/sales_invoice_lines.csv") else File.Contents(DataRoot & "\sales_invoice_lines.csv")),[Delimiter=",", Columns=28, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"数量", type text}, {"发票/账单日期", type date}, {"产品/内部参考号", type text}, {"产品/名称", type text}, {"产品/CN 品牌", type text}, {"产品/产品类别/中文名称", type text}, {"产品/产品类别/上级名称", type text}, {"产品/计量单位", type text}, {"合作伙伴", type text}, {"合作伙伴/参考", type text}, {"合作伙伴/销售员", type text}, {"合作伙伴/客户类型", type text}, {"合作伙伴/完整地址", type text}, {"合作伙伴/城市", type text}, {"合作伙伴/省/州", type text}, {"销售订单行/销售人员", type text}, {"销售订单行/创建人", type text}, {"数量_1", type number}, {"单价", type number}, {"小计", type number}, {"产品/基准成本", type number}, {"公司", type text}, {"销售订单行/仓库", type text}, {"Type", type text}, {"折扣后单价", type number}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([#"会计科目/类型"] = "收入")),
				    #"Clean Personnel" = Table.TransformColumns(
				        #"Filtered Rows",
				        {
				            {
				                "销售订单行/销售人员",
				                each
				                    let
				                        Name =
				                            if _ = null
				                            then ""
				                            else Text.Trim(Text.From(_))
				                    in
				                        if Name = ""
				                        then "未知人员"
				                        else Name,
				                type text
				            },
				            {
				                "销售订单行/创建人",
				                each
				                    let
				                        Name =
				                            if _ = null
				                            then ""
				                            else Text.Trim(Text.From(_))
				                    in
				                        if Name = ""
				                        then "未知人员"
				                        else Name,
				                type text
				            }
				        }
				    ),
				    #"删除期初数据SKU" =
				    Table.SelectRows(
				        #"Filtered Rows",
				        each
				            Text.Upper(
				                Text.Trim(
				                    Text.From(
				                        [#"产品/内部参考号"]
				                    )
				                )
				            ) <> "INITIALIZE"
				            and Text.Trim(
				                Text.From(
				                    [#"产品/名称"]
				                )
				            ) <> "期初数据SKU"
				    ),
				    #"Renamed Columns" = Table.RenameColumns(删除期初数据SKU,{{"数量", "发票编号"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

