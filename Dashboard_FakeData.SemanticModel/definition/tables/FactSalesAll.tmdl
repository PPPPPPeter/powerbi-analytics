	column 'Customer Channel' =
			
			VAR SalespersonName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactSalesAll[Sales Order Line/Created By],
			                ""
			            )
			        )
			    )
			VAR CustomerName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactSalesAll[Partner],
			                ""
			            )
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        SalespersonName = "MAINSTREAM", "Mainstream",
			        CustomerName IN {
			            "Harbor Spice Co",
			            "Summit Seasoning, LLC"
			        }, "Agent",
			        "Asian"
			    )
		lineageTag: 9f934f39-82d2-4b8e-8eab-64b657cd6269
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

