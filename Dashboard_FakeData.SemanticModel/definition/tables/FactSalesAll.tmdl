	column 'Product Class' =
			
			IF(
			    'FactSalesAll'[Product/Product Category/Category Name] = "Ice Cream",
			    "Ice Cream",
			    IF(
			        'FactSalesAll'[Product/Product Category/Parent Name] = "Beauty & Health & Home",
			        "Beauty",
			        "Other"
			    )
			)
		lineageTag: 3c64fd6a-d591-4d67-8625-ac31eed87740
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Order Creator_Display' =
			
			VAR CreatorName =
			    TRIM (
			        COALESCE (
			            FactSalesAll[Sales Order Line/Created By],
			            ""
			        )
			    )
			RETURN
			    IF (
			        CreatorName = "",
			        "Unknown Person",
			        CreatorName
			    )
		lineageTag: 7b6b687b-63ca-4653-baf6-be3a91e883d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

