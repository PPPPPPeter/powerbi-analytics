	column 产品分类 =
			
			IF(
			    'FactSalesAll'[产品/产品类别/中文名称] = "冰淇淋",
			    "冰淇淋",
			    IF(
			        'FactSalesAll'[产品/产品类别/上级名称] = "美容 & 健康 & 居家",
			        "美妆",
			        "其他"
			    )
			)
		lineageTag: 3c64fd6a-d591-4d67-8625-ac31eed87740
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 订单创建人_显示 =
			
			VAR CreatorName =
			    TRIM (
			        COALESCE (
			            FactSalesAll[销售订单行/创建人],
			            ""
			        )
			    )
			RETURN
			    IF (
			        CreatorName = "",
			        "未知人员",
			        CreatorName
			    )
		lineageTag: 7b6b687b-63ca-4653-baf6-be3a91e883d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

