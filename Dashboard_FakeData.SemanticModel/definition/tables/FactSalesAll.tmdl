	partition FactSalesAll = m
		mode: import
		source =
				let
				    Source = Csv.Document((if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/sales_invoice_lines.csv") else File.Contents(DataRoot & "\sales_invoice_lines.csv")),[Delimiter=",", Columns=28, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Quantity", type text}, {"Invoice/Bill Date", type date}, {"Product/Internal Reference", type text}, {"Product/Name", type text}, {"Product/CN Brand", type text}, {"Product/Product Category/Category Name", type text}, {"Product/Product Category/Parent Name", type text}, {"Product/Unit of Measure", type text}, {"Partner", type text}, {"Partner/Reference", type text}, {"Partner/Sales Rep", type text}, {"Partner/Customer Type", type text}, {"Partner/Full Address", type text}, {"Partner/City", type text}, {"Partner/Province/State", type text}, {"Sales Order Line/Salesperson", type text}, {"Sales Order Line/Created By", type text}, {"Quantity_1", type number}, {"Unit Price", type number}, {"Subtotal", type number}, {"Product/Base Cost", type number}, {"Company", type text}, {"Sales Order Line/Warehouse", type text}, {"Type", type text}, {"Discounted Unit Price", type number}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([#"Account/Type"] = "Revenue")),
				    #"Clean Personnel" = Table.TransformColumns(
				        #"Filtered Rows",
				        {
				            {
				                "Sales Order Line/Salesperson",
				                each
				                    let
				                        Name =
				                            if _ = null
				                            then ""
				                            else Text.Trim(Text.From(_))
				                    in
				                        if Name = ""
				                        then "Unknown Person"
				                        else Name,
				                type text
				            },
				            {
				                "Sales Order Line/Created By",
				                each
				                    let
				                        Name =
				                            if _ = null
				                            then ""
				                            else Text.Trim(Text.From(_))
				                    in
				                        if Name = ""
				                        then "Unknown Person"
				                        else Name,
				                type text
				            }
				        }
				    ),
				    #"RemoveOpeningBalanceSKU" =
				    Table.SelectRows(
				        #"Filtered Rows",
				        each
				            Text.Upper(
				                Text.Trim(
				                    Text.From(
				                        [#"Product/Internal Reference"]
				                    )
				                )
				            ) <> "INITIALIZE"
				            and Text.Trim(
				                Text.From(
				                    [#"Product/Name"]
				                )
				            ) <> "Opening Balance SKU"
				    ),
				    #"Renamed Columns" = Table.RenameColumns(RemoveOpeningBalanceSKU,{{"Quantity", "Invoice Number"}})
				in
				    #"Renamed Columns"

