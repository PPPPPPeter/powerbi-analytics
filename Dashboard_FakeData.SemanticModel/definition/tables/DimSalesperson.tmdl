table DimSalesperson
	lineageTag: 675e571f-3a1e-4552-8c24-ab9edb31b78b

	column Salesperson
		lineageTag: f3f720ac-3209-40e2-b6cc-d81ebd1cb11e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Salesperson]

		annotation SummarizationSetBy = Automatic

	partition DimSalesperson = calculated
		mode: import
		source =
				
				DISTINCT(
				    UNION(
				        ROW(
				            "Salesperson",
				            "Unknown Person"
				        ),
				        SELECTCOLUMNS(
				            FactBranchCost,
				            "Salesperson",
				            FactBranchCost[salesperson]
				        ),
				        SELECTCOLUMNS(
				            FactSalesTarget,
				            "Salesperson",
				            FactSalesTarget[Salesperson]
				        )
				    )
				)

	annotation PBI_Id = 59fa964997b74920baed8a18bfc451db

