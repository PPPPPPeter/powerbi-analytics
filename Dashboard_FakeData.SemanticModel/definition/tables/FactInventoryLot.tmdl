table FactInventoryLot
	lineageTag: ed3bf3c8-065d-4a32-aa21-e863113dc28f

	measure 'Estimated Loss Value' = SUM(FactInventoryLot[On Hand Qty])*SUM(FactInventoryLot[Product/Base Cost])
		lineageTag: d135fb6f-980a-4b6d-9e44-831a103e60da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days to Expiry' =
			
			VAR ExpiryDate =
			    CALCULATE(
			        MIN(FactInventoryLot[Expiry Date])
			        )
			RETURN
			    IF(
			        NOT HASONEVALUE(FactInventoryLot[Lot/Serial Number])
			            || ISBLANK(ExpiryDate),
			        BLANK(),
			        DATEDIFF(
			            TODAY(),
			            ExpiryDate,
			            DAY
			        )
			    )
		formatString: 0
		lineageTag: f51ff150-005d-4812-9495-25f905eb969b

