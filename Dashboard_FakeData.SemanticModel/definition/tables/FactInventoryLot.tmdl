table FactInventoryLot
	lineageTag: ed3bf3c8-065d-4a32-aa21-e863113dc28f

	measure 预计损失金额 = SUM(FactInventoryLot[在手数量])*SUM(FactInventoryLot[产品/基准成本])
		lineageTag: d135fb6f-980a-4b6d-9e44-831a103e60da

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 距有效期天数 =
			
			VAR ExpiryDate =
			    CALCULATE(
			        MIN(FactInventoryLot[有效期])
			        )
			RETURN
			    IF(
			        NOT HASONEVALUE(FactInventoryLot[批次/序列号码])
			            || ISBLANK(ExpiryDate),
			        BLANK(),
			        DATEDIFF(
			            TODAY(),
			            ExpiryDate,
			            DAY
			        )
			    )
		formatString: 0
		lineageTag: f51ff150-005d-4812-9495-25f905eb969b

