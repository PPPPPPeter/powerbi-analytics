	column 有效期状态 =
			
			VAR DaysLeft =
			    FactInventoryLot[距有效期天数]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DaysLeft), "无有效期",
			        DaysLeft <= 0, "已过期",
			        DaysLeft <= 30, "30天内到期",
			        DaysLeft <= 90, "31-90天到期",
			        DaysLeft <= 180, "91-180天到期",
			        "正常"
			    )
		lineageTag: f1043dc4-c1af-4aa2-b1f9-dc8e134a28aa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 保质期进度 =
			
			VAR ShelfLifeDays =
			    FactInventoryLot[产品/有效期]
			VAR RemainingDays =
			    DATEDIFF(
			        TODAY(),
			        FactInventoryLot[有效期],
			        DAY
			    )
			RETURN
			    IF(
			        ISBLANK(FactInventoryLot[有效期])
			            || ISBLANK(ShelfLifeDays)
			            || ShelfLifeDays <= 0,
			        BLANK(),
			        MAX(
			            0,
			            MIN(
			                1,
			                DIVIDE(
			                    ShelfLifeDays - RemainingDays,
			                    ShelfLifeDays
			                )
			            )
			        )
			    )
		lineageTag: b1362daf-5ad9-4860-9f1f-726665b7de49
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

