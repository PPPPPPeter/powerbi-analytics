	column 'Product/Sales Price'
		dataType: double
		lineageTag: 6ab72660-4ea9-40b6-9a2f-c3378f81fd29
		summarizeBy: sum
		sourceColumn: Product/Sales Price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Expiry Status' =
			
			VAR DaysLeft =
			    FactInventoryLot[Days to Expiry]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(DaysLeft), "No Expiry Date",
			        DaysLeft <= 0, "Expired",
			        DaysLeft <= 30, "Expires Within 30 Days",
			        DaysLeft <= 90, "31-90 Days to Expiry",
			        DaysLeft <= 180, "91-180 Days to Expiry",
			        "Normal"
			    )
		lineageTag: f1043dc4-c1af-4aa2-b1f9-dc8e134a28aa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Shelf Life Progress' =
			
			VAR ShelfLifeDays =
			    FactInventoryLot[Product/Expiry Date]
			VAR RemainingDays =
			    DATEDIFF(
			        TODAY(),
			        FactInventoryLot[Expiry Date],
			        DAY
			    )
			RETURN
			    IF(
			        ISBLANK(FactInventoryLot[Expiry Date])
			            || ISBLANK(ShelfLifeDays)
			            || ShelfLifeDays <= 0,
			        BLANK(),
			        MAX(
			            0,
			            MIN(
			                1,
			                DIVIDE(
			                    ShelfLifeDays - RemainingDays,
			                    ShelfLifeDays
			                )
			            )
			        )
			    )
		lineageTag: b1362daf-5ad9-4860-9f1f-726665b7de49
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

