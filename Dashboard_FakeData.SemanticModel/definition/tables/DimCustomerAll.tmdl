table DimCustomerAll
	lineageTag: 154e64a2-fbb2-4aca-8368-4358deb404f2

	measure 'New Customers Since 2026-08-01' =
			
			CALCULATE (
			    DISTINCTCOUNT ( DimCustomerAll[Customer ID] ),
			    DimCustomerAll[New Customer Since 2026-08-01 Flag] = 1
			)
		formatString: 0
		lineageTag: 75f13859-a6be-4774-a0ca-7549077db358

	measure 'All Branches Last Month Sales' =
			
			CALCULATE (
			    [Customer Sales_All Branches],
			    DATEADD ( DimDate[Date], -1, MONTH )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d2d33f89-6de6-4280-a9ff-33de58d49246

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'All Branches MoM' =
			
			VAR CurrentSales =
			    [Customer Sales_All Branches]
			VAR PreviousSales =
			    [All Branches Last Month Sales]
			RETURN
			    IF (
			        ISBLANK ( PreviousSales ) || PreviousSales = 0,
			        BLANK (),
			        DIVIDE (
			            CurrentSales - PreviousSales,
			            PreviousSales
			        )
			    )
		lineageTag: 389764ed-1187-45c6-b50a-ef592526b94b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Branch Customer Last Order Date' =
			
			CALCULATE (
			    MAX ( FactBranchCost[Invoice Date] ),
			    REMOVEFILTERS ( DimDate )
			)
		formatString: Short Date
		lineageTag: adf8d569-76a6-4bbe-99f0-1ac67a29cbcc

	measure 'Days Since Last Order' =
			
			VAR LastInv = [Branch Customer Last Order Date]
			RETURN
			    IF ( NOT ISBLANK ( LastInv ), DATEDIFF ( LastInv, TODAY (), DAY ) )
		formatString: 0
		lineageTag: bff3182a-83f1-4177-8370-085951daf462

