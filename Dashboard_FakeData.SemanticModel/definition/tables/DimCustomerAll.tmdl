	column 'Account Rep'
		lineageTag: 07a0fc9b-ab5c-40e5-9d18-4997760889d3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Account Rep]

		annotation SummarizationSetBy = Automatic

	column 'New Customer Since 2026-08-01 Flag' =
			
			IF(
			    NOT ISBLANK(DimCustomerAll[Customer First Order Date])
			        && DimCustomerAll[Customer First Order Date] > DATE(2026, 8, 1),
			    1,
			    0
			)
		lineageTag: 7e3cf246-e8db-4079-8d58-dee1f8554200
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Customer First Order Date' =
			
			VAR CurrentCustomer =
			    TRIM ( COALESCE ( DimCustomerAll[Customer ID], "" ) )
			RETURN
			    IF (
			        CurrentCustomer = "",
			        BLANK (),
			        MINX (
			            FILTER (
			                ALL ( FactBranchCost ),
			                TRIM (
			                    COALESCE ( FactBranchCost[customer_no], "" )
			                ) = CurrentCustomer
			            ),
			            FactBranchCost[Invoice Date]
			        )
			    )
		formatString: General Date
		lineageTag: a433c3e7-e7c9-40bc-84a1-7d6ed289ec15
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 8625bb64-d3b1-4878-bf95-878995f72f65
			defaultHierarchy: LocalDateTable_3f18ea92-57f6-46b8-bec8-769ab1e7ab9f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Company
		lineageTag: 95b73039-3076-4499-9e62-215549a8d91f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Company]

		annotation SummarizationSetBy = Automatic

	column 'Customer Grade Col' =
			
			VAR CustomerID =
			    DimCustomerAll[Customer ID]
			
			VAR Grade =
			    CALCULATE ( [Customer Grade] )
			
			RETURN
			    IF (
			        ISBLANK ( CustomerID ),
			        BLANK (),
			        COALESCE ( Grade, "Not Rated" )
			    )
		lineageTag: 4f62bae4-c550-441b-9af6-cb80e7a258cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Grade Sort' =
			
			SWITCH (
			    DimCustomerAll[Customer Grade Col],
			    "A", 1,
			    "B", 2,
			    "C", 3,
			    "D", 4,
			    "Not Rated", 5,
			    99
			)
		formatString: 0
		lineageTag: 85347c65-4256-4ccb-98f7-85de992e432a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Customer Company Key'
		lineageTag: 0830ceb1-d7a5-4933-95db-eb3431c33579
		summarizeBy: none
		isNameInferred
		sourceColumn: [Customer Company Key]

		annotation SummarizationSetBy = Automatic

	partition DimCustomerAll = calculated
		mode: import
		source =
				
				VAR CustomerData =
				    FILTER (
				        FactBranchCost,
				        NOT ISBLANK ( FactBranchCost[customer_no] )
				            && TRIM ( FactBranchCost[customer_no] & "" ) <> ""
				            && NOT ISBLANK ( FactBranchCost[company] )
				            && TRIM ( FactBranchCost[company] & "" ) <> ""
				    )
				
				RETURN
				SELECTCOLUMNS (
				    SUMMARIZE (
				        CustomerData,
				        FactBranchCost[customer_no],
				        FactBranchCost[company],
				
				        "Customer Name Summary",
				            CALCULATE ( MAX ( FactBranchCost[customer_name] ) ),
				
				        "Customer Type Summary",
				            CALCULATE ( MAX ( FactBranchCost[customer_type] ) ),
				
				        "City Summary",
				            CALCULATE ( MAX ( FactBranchCost[city] ) ),
				
				        "State Summary",
				            CALCULATE ( MAX ( FactBranchCost[state] ) ),
				
				        "Ethnicity Summary",
				            CALCULATE ( MAX ( FactBranchCost[race] ) ),
				
				        "Salesperson Summary",
				            CALCULATE ( MAX ( FactBranchCost[salesperson] ) ),
				
				        "Sales Leader Summary",
				            CALCULATE ( MAX ( FactBranchCost[sales leader] ) ),
				
				        "Account Rep Summary",
				            CALCULATE ( MAX ( FactBranchCost[rep] ) )
				    ),
				
				    "Customer Company Key",
				        TRIM ( FactBranchCost[customer_no] & "" )
				            & "|"
				            & TRIM ( FactBranchCost[company] & "" ),
				
				    "Customer ID", FactBranchCost[customer_no],
				    "Customer Name", [Customer Name Summary],
				    "Customer Type", [Customer Type Summary],
				    "City", [City Summary],
				    "State", [State Summary],
				    "Ethnicity", [Ethnicity Summary],
				    "Salesperson", [Salesperson Summary],
				    "Sales Leader", [Sales Leader Summary],
				    "Account Rep", [Account Rep Summary],
				    "Company", FactBranchCost[company]
				)

	annotation PBI_Id = 71e45fc5d75546c09a28295ae0d2b710

