	column 2026年8月1日后新客户标记 =
			
			IF(
			    NOT ISBLANK(DimCustomerAll[客户首次下单日期])
			        && DimCustomerAll[客户首次下单日期] > DATE(2026, 8, 1),
			    1,
			    0
			)
		lineageTag: 7e3cf246-e8db-4079-8d58-dee1f8554200
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 客户首次下单日期 =
			
			VAR CurrentCustomer =
			    TRIM ( COALESCE ( DimCustomerAll[客户编号], "" ) )
			RETURN
			    IF (
			        CurrentCustomer = "",
			        BLANK (),
			        MINX (
			            FILTER (
			                ALL ( FactBranchCost ),
			                TRIM (
			                    COALESCE ( FactBranchCost[customer_no], "" )
			                ) = CurrentCustomer
			            ),
			            FactBranchCost[Invoice Date]
			        )
			    )
		formatString: General Date
		lineageTag: a433c3e7-e7c9-40bc-84a1-7d6ed289ec15
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 8625bb64-d3b1-4878-bf95-878995f72f65
			defaultHierarchy: LocalDateTable_3f18ea92-57f6-46b8-bec8-769ab1e7ab9f.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 公司
		lineageTag: 95b73039-3076-4499-9e62-215549a8d91f
		summarizeBy: none
		isNameInferred
		sourceColumn: [公司]

		annotation SummarizationSetBy = Automatic

	column 客户等级列 =
			
			VAR CustomerID =
			    DimCustomerAll[客户编号]
			
			VAR Grade =
			    CALCULATE ( [客户等级] )
			
			RETURN
			    IF (
			        ISBLANK ( CustomerID ),
			        BLANK (),
			        COALESCE ( Grade, "未评级" )
			    )
		lineageTag: 4f62bae4-c550-441b-9af6-cb80e7a258cc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 客户等级排序 =
			
			SWITCH (
			    DimCustomerAll[客户等级列],
			    "A", 1,
			    "B", 2,
			    "C", 3,
			    "D", 4,
			    "未评级", 5,
			    99
			)
		formatString: 0
		lineageTag: 85347c65-4256-4ccb-98f7-85de992e432a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 客户公司Key
		lineageTag: 0830ceb1-d7a5-4933-95db-eb3431c33579
		summarizeBy: none
		isNameInferred
		sourceColumn: [客户公司Key]

		annotation SummarizationSetBy = Automatic

	partition DimCustomerAll = calculated
		mode: import
		source =
				
				VAR CustomerData =
				    FILTER (
				        FactBranchCost,
				        NOT ISBLANK ( FactBranchCost[customer_no] )
				            && TRIM ( FactBranchCost[customer_no] & "" ) <> ""
				            && NOT ISBLANK ( FactBranchCost[company] )
				            && TRIM ( FactBranchCost[company] & "" ) <> ""
				    )
				
				RETURN
				SELECTCOLUMNS (
				    SUMMARIZE (
				        CustomerData,
				        FactBranchCost[customer_no],
				        FactBranchCost[company],
				
				        "客户名称汇总",
				            CALCULATE ( MAX ( FactBranchCost[customer_name] ) ),
				
				        "客户类型汇总",
				            CALCULATE ( MAX ( FactBranchCost[customer_type] ) ),
				
				        "城市汇总",
				            CALCULATE ( MAX ( FactBranchCost[city] ) ),
				
				        "省州汇总",
				            CALCULATE ( MAX ( FactBranchCost[state] ) ),
				
				        "种族汇总",
				            CALCULATE ( MAX ( FactBranchCost[race] ) ),
				
				        "销售人员汇总",
				            CALCULATE ( MAX ( FactBranchCost[salesperson] ) ),
				
				        "销售主管汇总",
				            CALCULATE ( MAX ( FactBranchCost[sales leader] ) ),
				
				        "业务代表汇总",
				            CALCULATE ( MAX ( FactBranchCost[rep] ) )
				    ),
				
				    "客户公司Key",
				        TRIM ( FactBranchCost[customer_no] & "" )
				            & "|"
				            & TRIM ( FactBranchCost[company] & "" ),
				
				    "客户编号", FactBranchCost[customer_no],
				    "客户名称", [客户名称汇总],
				    "客户类型", [客户类型汇总],
				    "城市", [城市汇总],
				    "省州", [省州汇总],
				    "种族", [种族汇总],
				    "销售人员", [销售人员汇总],
				    "销售主管", [销售主管汇总],
				    "业务代表", [业务代表汇总],
				    "公司", FactBranchCost[company]
				)

	annotation PBI_Id = 71e45fc5d75546c09a28295ae0d2b710

