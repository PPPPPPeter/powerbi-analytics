table DimCustomerAll
	lineageTag: 154e64a2-fbb2-4aca-8368-4358deb404f2

	measure 2026年8月1日后新客户数 =
			
			CALCULATE (
			    DISTINCTCOUNT ( DimCustomerAll[客户编号] ),
			    DimCustomerAll[2026年8月1日后新客户标记] = 1
			)
		formatString: 0
		lineageTag: 75f13859-a6be-4774-a0ca-7549077db358

	measure 全部分公司上月销售额 =
			
			CALCULATE (
			    [客户销售额_全部分公司],
			    DATEADD ( DimDate[Date], -1, MONTH )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: d2d33f89-6de6-4280-a9ff-33de58d49246

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 全部分公司月环比 =
			
			VAR CurrentSales =
			    [客户销售额_全部分公司]
			VAR PreviousSales =
			    [全部分公司上月销售额]
			RETURN
			    IF (
			        ISBLANK ( PreviousSales ) || PreviousSales = 0,
			        BLANK (),
			        DIVIDE (
			            CurrentSales - PreviousSales,
			            PreviousSales
			        )
			    )
		lineageTag: 389764ed-1187-45c6-b50a-ef592526b94b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司客户上次下单日期 =
			
			CALCULATE (
			    MAX ( FactBranchCost[Invoice Date] ),
			    REMOVEFILTERS ( DimDate )
			)
		formatString: Short Date
		lineageTag: adf8d569-76a6-4bbe-99f0-1ac67a29cbcc

	measure 距离上次下单天数 =
			
			VAR LastInv = [分公司客户上次下单日期]
			RETURN
			    IF ( NOT ISBLANK ( LastInv ), DATEDIFF ( LastInv, TODAY (), DAY ) )
		formatString: 0
		lineageTag: bff3182a-83f1-4177-8370-085951daf462

