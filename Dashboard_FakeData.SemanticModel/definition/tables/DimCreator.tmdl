table DimCreator
	lineageTag: 41905e57-3837-4dab-8f6d-0e338ef4e658

	measure 'Avg Monthly MoM' =
			
			AVERAGEX(VALUES(DimDate[Year Month]), CALCULATE([MoM]))
		lineageTag: 0040d177-bceb-4a75-917e-406e174aad9d

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Branch MoM average per Year Month' =
			
			AVERAGEX(KEEPFILTERS(VALUES('DimDate'[Year Month])), CALCULATE([Branch MoM]))
		lineageTag: 99821af4-653d-4908-a23e-d079e631a561

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "AveragePerCategory"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Order Creator'
		lineageTag: 1da5dd1c-d4ea-4528-807a-7850ea0aa6d9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Order Creator]

		annotation SummarizationSetBy = Automatic

	partition DimCreator = calculated
		mode: import
		source =
				
				DISTINCT (
				    UNION (
				        SELECTCOLUMNS (
				            FactBranchCost,
				            "Order Creator", FactBranchCost[Order Creator]
				        ),
				        SELECTCOLUMNS (
				            FactSalesTarget,
				            "Order Creator", FactSalesTarget[Salesperson]
				        )
				    )
				)

	annotation PBI_Id = a91fdf1c793448a398a21bdda13ad035

