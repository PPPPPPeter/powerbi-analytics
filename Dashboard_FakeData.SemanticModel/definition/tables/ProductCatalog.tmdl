	partition ProductCatalog = calculated
		mode: import
		source =
				
				DISTINCT(
				    SELECTCOLUMNS(
				        DimProductAll,
				        "SKU", DimProductAll[SKU],
				        "Product Name", DimProductAll[Product Name],
				        "Brand", DimProductAll[Brand],
				        "Product Group", DimProductAll[Product Group],
				        "Product Category", DimProductAll[Product Category],
				        "Unit of Measure", DimProductAll[Unit of Measure]
				    )
				)

