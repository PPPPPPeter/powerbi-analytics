table FactBranchCost
	lineageTag: 2d687104-897e-4783-80af-f70bdeb39b8e

	measure 分公司销售额（不含运费和服务费） =
			
			CALCULATE (
			    SUM ( FactBranchCost[amount] ),
			    KEEPFILTERS (
			        NOT (
			            FactBranchCost[Ref Num]
			                IN { "RDC", "SHH", "Service Fee", "C-1" }
			        )
			    )
			)
		lineageTag: 31c7a2ac-2b31-482f-a5c2-9182255fe320

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司销售占比 =
			
			VAR CurrentSales =
			    [分公司销售额（不含运费和服务费）]
			VAR AllCompanySales =
			    CALCULATE(
			        [分公司销售额（不含运费和服务费）],
			        REMOVEFILTERS(FactBranchCost[company]),
			        REMOVEFILTERS(DimCustomerAll[客户名称])
			    )
			RETURN
			    DIVIDE(CurrentSales, AllCompanySales)
		lineageTag: 26ae6f25-1f93-48fb-99f0-af53b7637fe6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司上月销售额 =
			
			COALESCE(
			    CALCULATE(
			        [分公司销售额（不含运费和服务费）],
			        DATEADD(DimDate[Date], -1, MONTH)
			    ),
			    0
			)
		lineageTag: b4cb9dfd-f9d6-4137-980b-1d5125286825

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司月环比 =
			
			DIVIDE(
			    [分公司销售额（不含运费和服务费）] - [分公司上月销售额],
			    [分公司上月销售额],
			    0
			)
		lineageTag: b1b497c8-dd4e-44e7-b4ea-12ae90dfa78b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司上年同期销售额 =
			
			CALCULATE(
			    [分公司销售额（不含运费和服务费）],
			    DATEADD(
			        DimDate[Date],
			        -1,
			        YEAR
			    )
			)
		lineageTag: fe2d26c3-fdc8-494b-a86d-7a537e84ff3b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司销售同比 =
			
			DIVIDE(
			    [分公司销售额（不含运费和服务费）] - [分公司上年同期销售额],
			    [分公司上年同期销售额],
			    0
			)
		lineageTag: f38cf50e-73f3-4e78-98eb-9968792427b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司活跃客户 =
			
			COUNTROWS(
			    FILTER(
			        VALUES(FactBranchCost[customer_no]),
			        NOT ISBLANK(FactBranchCost[customer_no])
			            && FactBranchCost[customer_no] <> ""
			            && CALCULATE([分公司销售额（不含运费和服务费）]) > 0
			    )
			)
		formatString: 0
		lineageTag: 289acafb-7c4f-41d5-aaae-7973838e9942

	measure 分公司订单数 =
			
			DISTINCTCOUNT(FactBranchCost[分公司订单键])
		formatString: 0
		lineageTag: fd7f78bd-2fbe-4636-9d55-d07e7ffb74a0

	measure 分公司活跃SKU =
			
			COUNTROWS(
			    FILTER(
			        VALUES(FactBranchCost[Ref Num]),
			        NOT ISBLANK(FactBranchCost[Ref Num])
			            && FactBranchCost[Ref Num] <> ""
			            && CALCULATE([分公司销售额（不含运费和服务费）]) > 0
			    )
			)
		formatString: 0
		lineageTag: 38c886af-66ad-437b-938a-008b8ccce47f

	measure 分公司品牌销售占比 =
			
			VAR CurrentBrandSales =
			    [分公司销售额（不含运费和服务费）]
			VAR BranchTotalSales =
			    CALCULATE(
			        [分公司销售额（不含运费和服务费）],
			        REMOVEFILTERS(ProductCatalogAll[品牌])
			    )
			RETURN
			    DIVIDE(
			        CurrentBrandSales,
			        BranchTotalSales,
			        0
			    )
		lineageTag: 8959a041-64bd-4675-a98b-e147b86bc761

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司基准成本 =
			
