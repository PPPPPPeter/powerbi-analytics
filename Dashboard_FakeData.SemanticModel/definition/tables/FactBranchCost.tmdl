	partition FactBranchCost = m
		mode: import
		source =
				let
				    FiniteNumber = (ValueToConvert as any) as nullable number =>
				        let
				            Converted = try Number.From(ValueToConvert, "en-US") otherwise null
				        in
				            if Converted = null
				                or Converted = Number.PositiveInfinity
				                or Converted = Number.NegativeInfinity
				                or Number.IsNaN(Converted)
				            then null
				            else Converted,
				
				    Source =
				        Csv.Document(
				            (if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/branch_sales.csv") else File.Contents(DataRoot & "\branch_sales.csv")),
				            [
				                Delimiter = ",",
				                Encoding = 65001,
				                QuoteStyle = QuoteStyle.Csv
				            ]
				        ),
				
				    PromotedHeaders =
				        Table.PromoteHeaders(
				            Source,
				            [PromoteAllScalars = true]
				        ),
				
				    // 将 CSV 字段名转换为 FactBranchCost 使用的标准字段名
				    RenamedColumns =
				        Table.RenameColumns(
				            PromotedHeaders,
				            {
				                {"lnvoice No", "Invoice No"},
				                {"purchase_price", "基准成本单价"},
				                {"cogs", "基准成本"},
				                {"Gross Profit", "基准毛利额"},
				                {"Gross Margin", "基准毛利率"},
				                {"Sales Order Line / Created By", "订单创建人"},
				                {"Sales Order Line / Order Reference", "订单参考号"},
				                {"Partner / Complete Address","完整地址"}
				            },
				            MissingField.Ignore
				        ),
				
				    StandardColumns = {
				        "Invoice No", "Invoice Date", "Ref Num", "product_name",
				        "in_charge", "brand_cn_name", "brand_name", "Category (CN)",
				        "Sub-Category (CN)", "shelf life", "customer_name", "customer_no",
				        "sales leader", "salesperson", "rep", "customer_type", "city",
				        "state", "Create User", "race", "quantity", "discount_price",
				        "amount", "基准成本单价", "基准成本", "基准毛利额", "基准毛利率",
				        "month", "week", "year", "company", "Warehouse","订单创建人","订单参考号","完整地址"
				    },
				
				    SelectedColumns =
				        Table.SelectColumns(
				            RenamedColumns,
				            StandardColumns,
				            MissingField.UseNull
				        ),
				
				    RemovedEmptyRows =
				        Table.SelectRows(
				            SelectedColumns,
				            each [Invoice No] <> null
				                or [Invoice Date] <> null
				                or [Ref Num] <> null
				        ),
				
				    CleanedText =
				        Table.TransformColumns(
				            RemovedEmptyRows,
				            List.Transform(
				                {
				                    "Invoice No", "Ref Num", "product_name", "in_charge",
				                    "brand_cn_name", "brand_name", "Category (CN)",
				                    "Sub-Category (CN)", "customer_name", "customer_no",
				                    "sales leader", "salesperson", "rep", "customer_type",
				                    "city", "state", "Create User", "race", "company",
				                    "Warehouse","订单创建人","订单参考号","完整地址"
				                },
				                (ColumnName as text) =>
				                    {
				                        ColumnName,
				                        each
				                            if _ = null
				                            then null
				                            else Text.Clean(Text.Trim(Text.From(_))),
				                        type text
				                    }
				            )
				        ),
				
				    SanitizedNumbers =
				        Table.TransformColumns(
				            CleanedText,
				            List.Transform(
				                {
				                    "shelf life", "quantity", "discount_price", "amount",
				                    "基准成本单价", "基准成本", "基准毛利额", "基准毛利率",
				                    "month", "week", "year"
				                },
				                (ColumnName as text) =>
				                    {
				                        ColumnName,
				                        each FiniteNumber(_),
				                        type nullable number
				                    }
				            )
				        ),
				
				    ParsedInvoiceDate =
				        Table.TransformColumns(
				            SanitizedNumbers,
				            {
				                {
				                    "Invoice Date",
				                    each
				                        if _ = null or Text.Trim(Text.From(_)) = ""
				                        then null
				                        else
				                            try Date.From(_)
				                            otherwise
				                                try Date.FromText(
				                                    Text.Start(Text.From(_), 10),
				                                    [Culture = "en-US"]
				                                )
				                                otherwise null,
				                    type nullable date
				                }
				            }
				        ),
				
				    ChangedTypes =
				        Table.TransformColumnTypes(
				            ParsedInvoiceDate,
				            {
				                {"Invoice No", type text},
				                {"Invoice Date", type date},
				                {"Ref Num", type text},
				                {"product_name", type text},
				                {"in_charge", type text},
				                {"brand_cn_name", type text},
				                {"brand_name", type text},
				                {"Category (CN)", type text},
				                {"Sub-Category (CN)", type text},
				                {"shelf life", Int64.Type},
				                {"customer_name", type text},
				                {"customer_no", type text},
				                {"sales leader", type text},
				                {"salesperson", type text},
				                {"rep", type text},
				                {"customer_type", type text},
				                {"city", type text},
				                {"state", type text},
				                {"Create User", type text},
				                {"race", type text},
				                {"quantity", type number},
				                {"discount_price", type number},
				                {"amount", Currency.Type},
				                {"基准成本单价", Currency.Type},
				                {"基准成本", Currency.Type},
				                {"基准毛利额", Currency.Type},
				                {"基准毛利率", Percentage.Type},
				                {"month", Int64.Type},
				                {"week", Int64.Type},
				                {"year", Int64.Type},
				                {"company", type text},
				                {"Warehouse", type text}
				            },
				            "en-US"
				        ),
				    #"Filtered Rows" = Table.SelectRows(ChangedTypes, each not Text.Contains([customer_name], "Employee")),
				    #"Trimmed Text" = Table.TransformColumns(#"Filtered Rows",{{"完整地址", Text.Trim, type text}})
				in
				    #"Trimmed Text"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

