	measure 产品价格_毛利 = ```
			
			    [分公司销售额（不含运费和服务费）]
			        - [产品价格_基准成本]
			```
		lineageTag: bf7f6306-5c52-4d8a-be31-951ed0dea3f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 产品价格_毛利率 =
			
			DIVIDE (
			    [产品价格_毛利],
			    [分公司销售额（不含运费和服务费）],
			    BLANK ()
			)
		lineageTag: 5806a4df-f4f8-4450-b9ba-c88ad48ac190

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司销售数量 =
			
			CALCULATE (
			    SUM ( FactBranchCost[quantity] ),
			    KEEPFILTERS (
			        NOT (
			            FactBranchCost[Ref Num]
			                IN { "RDC", "SHH", "Service Fee", "C-1" }
			        )
			    )
			)
		lineageTag: 1a6ba313-1055-4b06-b117-806b8bc6f299

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 产品价格_加权平均成交价 =
			
			VAR SalesAmount =
			    [分公司销售额（不含运费和服务费）]
			
			VAR SalesQuantity =
			    [分公司销售数量]
			
			RETURN
			    IF (
			        SalesQuantity > 0,
			        DIVIDE ( SalesAmount, SalesQuantity ),
			        BLANK ()
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 743a6cea-db4c-4c93-ac78-3b0ef3e32bbd

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 分公司上月销售数量 =
			
			VAR CurrentDate =
			    MAX(DimDate[Date])
			VAR CurrentMonthStart =
			    DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR PreviousMonthStart =
			    EDATE(CurrentMonthStart, -1)
			VAR PreviousMonthEnd =
			    CurrentMonthStart - 1
			RETURN
			    CALCULATE(
			        [分公司销售数量],
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[Date],
			            PreviousMonthStart,
			            PreviousMonthEnd
			        )
			    )
		lineageTag: b292b627-f82c-48d6-ae92-cb0055827f7e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司销量月环比 =
			
			VAR CurrentQuantity =
			    [分公司销售数量]
			VAR PreviousQuantity =
			    [分公司上月销售数量]
			RETURN
			    IF(
			        ISBLANK(PreviousQuantity)
			            || PreviousQuantity = 0,
			        BLANK(),
			        DIVIDE(
			            CurrentQuantity - PreviousQuantity,
			            PreviousQuantity
			        )
			    )
		lineageTag: 2ee33397-cefe-497e-a910-7bb2261362f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 所选品牌订单数 =
			
			VAR SelectedBrands =
			    VALUES ( ProductCatalogAll[品牌] )
			RETURN
			CALCULATE (
			    [分公司订单数],
			
			    REMOVEFILTERS ( ProductCatalogAll ),
			    REMOVEFILTERS ( ProductCatalog ),
			    REMOVEFILTERS ( DimProductAll ),
			
			    TREATAS (
			        SelectedBrands,
			        FactBranchCost[brand_cn_name]
			    )
			)
		formatString: 0
		lineageTag: 0ebd1e1f-af22-46a4-a382-c7dc599c7a0e

	measure 客户本期订单数 =
			
			CALCULATE (
			    [分公司订单数],
			
			    REMOVEFILTERS ( ProductCatalogAll ),
			    REMOVEFILTERS ( ProductCatalog ),
			    REMOVEFILTERS ( DimProductAll ),
			
			    REMOVEFILTERS ( FactBranchCost[brand_cn_name] ),
			    REMOVEFILTERS ( FactBranchCost[brand_name] ),
			    REMOVEFILTERS ( FactBranchCost[Ref Num] ),
			    REMOVEFILTERS ( FactBranchCost[product_name] )
			)
		formatString: 0
		lineageTag: c98551a1-95fa-4e3e-9c4c-0d13b8f311a6

	measure 品牌未铺货客户标记 =
			
			VAR HasBrand =
			    HASONEVALUE ( ProductCatalogAll[品牌] )
			
			VAR CustomerOrders =
			    COALESCE ( [客户本期订单数], 0 )
			
			VAR BrandOrders =
			    COALESCE ( [所选品牌订单数], 0 )
			
			RETURN
			IF (
			    NOT HasBrand || CustomerOrders <= 0,
			    BLANK (),
			    IF ( BrandOrders = 0, 1, 0 )
			)
		formatString: 0
		lineageTag: d0d94949-2707-4d51-b3c9-e5a32198f23a

	measure 分公司上月订单数 =
			
			CALCULATE(
			    [分公司订单数],
			    DATEADD(DimDate[Date], -1, MONTH)
			)
		formatString: 0
		lineageTag: 63aae6c1-fb18-4725-a088-7148d3e2c159

	measure 分公司订单数月环比 =
			
			VAR CurrentOrders =
			    [分公司订单数]
			VAR PreviousOrders =
			    [分公司上月订单数]
			RETURN
			    IF(
			        ISBLANK(PreviousOrders)
			            || PreviousOrders = 0,
			        BLANK(),
			        DIVIDE(
			            CurrentOrders - PreviousOrders,
			            PreviousOrders
			        )
			    )
		lineageTag: d44afcac-8d9e-4a6e-8137-83d992b50fbd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 品牌已铺货客户标记 =
			
			VAR HasBrand =
			    HASONEVALUE ( ProductCatalogAll[品牌] )
			
			VAR CustomerOrders =
			    COALESCE ( [客户本期订单数], 0 )
			
			VAR BrandOrders =
			    COALESCE ( [所选品牌订单数], 0 )
			
			RETURN
			IF (
			    NOT HasBrand || CustomerOrders <= 0,
			    BLANK (),
			    IF ( BrandOrders > 0, 1, 0 )
			)
		formatString: 0
		lineageTag: 9bd20f3e-a0ad-4e76-a460-7137cc1df58d

	measure 销售已铺货客户数 =
			
			COUNTROWS(
			    FILTER(
			        VALUES(DimCustomerAll[客户编号]),
			        CALCULATE([分公司销售额（不含运费和服务费）]) > 0
			    )
			)
		formatString: 0
		lineageTag: e6add068-024c-4c7c-8231-5220bcc1401d

	measure 销售已铺货SKU数 =
			
			CALCULATE(
			    DISTINCTCOUNT(FactBranchCost[Ref Num]),
			    FactBranchCost[amount] > 0,
			    FactBranchCost[Ref Num] <> BLANK()
			)
		formatString: 0
		lineageTag: b0c6f272-d63a-4011-9b89-b555cee1083f

	measure 销售客户铺货率 =
			
			DIVIDE(
			    [销售已铺货客户数],
			    [销售负责客户数],
			    0
			)
		lineageTag: e2017523-74cb-4fc6-aacb-32837f123846

