	column 客户地址 =
			
			VAR CustomerCity =
			    TRIM(
			        COALESCE(
			            FactBranchCost[city],
			            ""
			        )
			    )
			VAR CustomerState =
			    TRIM(
			        COALESCE(
			            FactBranchCost[state],
			            ""
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        CustomerCity = "" && CustomerState = "", BLANK(),
			        CustomerCity = "", CustomerState,
			        CustomerState = "", CustomerCity,
			        CustomerCity & ", " & CustomerState
			    )
		lineageTag: be571570-e164-4c5a-b95e-a8c9b9ee3f11
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 客户渠道 =
			
			VAR SalespersonName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactBranchCost[salesperson],
			                ""
			            )
			        )
			    )
			VAR CustomerName =
			    UPPER(
			        TRIM(
			            COALESCE(
			                FactBranchCost[customer_name],
			                ""
			            )
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        SalespersonName = "MAINSTREAM", "主流",
			        CustomerName IN {
			            "Harbor Spice Co",
			            "Summit Seasoning, LLC"
			        }, "代理",
			        "亚裔"
			    )
		lineageTag: 41df5686-1f13-427d-827f-30933834c9d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 分公司订单键 =
			
			VAR CompanyName =
			    TRIM(COALESCE(FactBranchCost[company], ""))
			VAR InvoiceNumber =
			    TRIM(COALESCE(FactBranchCost[Invoice No], ""))
			RETURN
			    IF(
			        CompanyName = "" || InvoiceNumber = "",
			        BLANK(),
			        COMBINEVALUES("|", CompanyName, InvoiceNumber)
			    )
		lineageTag: f0d6c80c-3c0d-4caa-ba2c-e8699e8cf312
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 客户公司Key =
			
			VAR CustomerNumber =
			    TRIM (
			        COALESCE (
			            FactBranchCost[customer_no] & "",
			            ""
			        )
			    )
			
			VAR CompanyName =
			    TRIM (
			        COALESCE (
			            FactBranchCost[company] & "",
			            ""
			        )
			    )
			
			RETURN
			    IF (
			        CustomerNumber = ""
			            || CompanyName = "",
			        BLANK (),
			        CustomerNumber & "|" & CompanyName
			    )
		lineageTag: d775ec6e-c849-4928-a972-b54b53a4e9c9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

