		lineageTag: 638c7655-c6ee-453a-960f-596a194441c2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure State销售占比 =
			
			DIVIDE (
			    [分公司销售额（不含运费和服务费）],
			    CALCULATE (
			        [分公司销售额（不含运费和服务费）],
