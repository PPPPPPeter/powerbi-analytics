	measure 本期目标客户数 =
			
			VAR CustomerList =
			    CALCULATETABLE (
			        VALUES ( DimCustomerAll[客户编号] ),
			        REMOVEFILTERS ( ProductCatalogAll ),
			        REMOVEFILTERS ( ProductCatalog ),
			        REMOVEFILTERS ( DimProductAll )
			    )
			RETURN
			SUMX (
			    CustomerList,
			    IF (
			        CALCULATE ( [客户本期订单数] ) > 0,
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: bee9c0ce-ed10-48bf-aef1-d03546a670f8

	measure 公司经营SKU标记 =
			
			VAR SelectedCompanies =
			    VALUES ( DimCustomerAll[公司] )
			
			VAR HistoricalSales =
			    CALCULATE (
			        COUNTROWS ( FactBranchCost ),
			
			        FactBranchCost[Ref Num] <> BLANK (),
			        FactBranchCost[amount] > 0,
			
			        -- 清除客户维度筛选
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( DimCustomerNJ ),
			
			        -- 清除事实表中的客户和销售人员筛选
			        REMOVEFILTERS (
			            FactBranchCost[customer_no],
			            FactBranchCost[customer_name],
			            FactBranchCost[customer_type],
			            FactBranchCost[race],
			            FactBranchCost[salesperson],
			            FactBranchCost[sales leader],
			            FactBranchCost[rep]
			        ),
			
			        -- 不受日期筛选影响
			        REMOVEFILTERS ( DimDate ),
			
			        REMOVEFILTERS (
			            FactBranchCost[Invoice Date],
			            FactBranchCost[month],
			            FactBranchCost[week],
			            FactBranchCost[year]
			        ),
			
			        -- 恢复公司选择
			        TREATAS (
			            SelectedCompanies,
			            FactBranchCost[company]
			        )
			    )
			
			RETURN
			    IF ( HistoricalSales > 0, 1, 0 )
		formatString: 0
		lineageTag: 3accec6d-53ec-4bb2-99c5-a7eea11da07c

	measure 公司经营SKU总数 =
			
			SUMX (
			    VALUES ( FactBranchCost[Ref Num] ),
			    [公司经营SKU标记]
			)
		formatString: 0
		lineageTag: fdf22673-6d4b-4a22-aac7-349e6111b2a7

	measure 本期已铺货SKU标记 =
			
			VAR SelectedCompanies =
			    VALUES ( DimCustomerAll[公司] )
			
			VAR SelectedCustomers =
			    VALUES ( FactBranchCost[customer_no] )
			
			VAR SelectedSKUs =
			    VALUES ( FactBranchCost[Ref Num] )
			
			VAR IsCompanySKU =
			    CALCULATE (
			        [公司经营SKU标记],
			
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( DimCustomerNJ ),
			
			        TREATAS (
			            SelectedCompanies,
			            FactBranchCost[company]
			        )
			    )
			
			VAR CurrentQuantity =
			    CALCULATE (
			        SUM ( FactSalesAll[数量_1] ),
			
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( DimCustomerNJ ),
			
			        TREATAS (
			            SelectedCompanies,
			            FactSalesAll[公司]
			        ),
			
			        TREATAS (
			            SelectedCustomers,
			            FactSalesAll[合作伙伴/参考]
			        ),
			
			        TREATAS (
			            SelectedSKUs,
			            FactSalesAll[产品/内部参考号]
			        )
			    )
			
			RETURN
			    IF (
			        IsCompanySKU <> 1,
			        BLANK (),
			        IF ( COALESCE ( CurrentQuantity, 0 ) > 0, 1, 0 )
			    )
		formatString: 0
		lineageTag: 89233c9f-c9bd-4723-bd68-bee803d0304f

	measure 本期未铺货SKU标记 =
			
			VAR SelectedCompanies =
			    VALUES ( DimCustomerAll[公司] )
			
			VAR SelectedCustomers =
			    VALUES ( FactBranchCost[customer_no] )
			
			VAR SelectedSKUs =
			    VALUES ( FactBranchCost[Ref Num] )
			
			VAR IsCompanySKU =
			    CALCULATE (
			        [公司经营SKU标记],
			
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( DimCustomerNJ ),
			
			        TREATAS (
			            SelectedCompanies,
			            FactBranchCost[company]
			        )
			    )
			
			VAR CurrentQuantity =
			    CALCULATE (
			        SUM ( FactSalesAll[数量_1] ),
			
			        REMOVEFILTERS ( DimCustomerAll ),
			        REMOVEFILTERS ( DimCustomerNJ ),
			
			        TREATAS (
			            SelectedCompanies,
			            FactSalesAll[公司]
			        ),
			
			        TREATAS (
			            SelectedCustomers,
			            FactSalesAll[合作伙伴/参考]
			        ),
			
			        TREATAS (
			            SelectedSKUs,
			            FactSalesAll[产品/内部参考号]
			        )
			    )
			
			RETURN
			    IF (
			        IsCompanySKU <> 1,
			        BLANK (),
			        IF ( COALESCE ( CurrentQuantity, 0 ) <= 0, 1, 0 )
			    )
		formatString: 0
		lineageTag: bfaf6737-0ab4-4933-ad14-501ccbe1f83f

	measure 毛利率趋势_近3月 =
			
			VAR CurrentMonthKey =
			    MAX ( DimDate[年月排序] )
			
			VAR VisibleMonths =
			    SUMMARIZE (
			        ALLSELECTED ( DimDate ),
			        DimDate[年月],
			        DimDate[年月排序]
			    )
			
			VAR Last3VisibleMonths =
			    TOPN (
			        3,
			        FILTER (
			            VisibleMonths,
			            DimDate[年月排序] <= CurrentMonthKey
			        ),
			        DimDate[年月排序],
			        DESC
			    )
			
			RETURN
			    AVERAGEX (
			        Last3VisibleMonths,
			        CALCULATE ( [产品价格_毛利率] )
			    )
		lineageTag: f1852e99-e562-40ea-a74c-690315100deb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 分公司销售数量趋势_近3月 =
			
			VAR CurrentMonthKey =
			    MAX ( DimDate[年月排序] )
			
			VAR VisibleMonths =
			    SUMMARIZE (
			        ALLSELECTED ( DimDate ),
			        DimDate[年月],
			        DimDate[年月排序]
			    )
			
			VAR Last3VisibleMonths =
			    TOPN (
			        3,
			        FILTER (
			            VisibleMonths,
			            DimDate[年月排序] <= CurrentMonthKey
			        ),
			        DimDate[年月排序],
			        DESC
			    )
			
			RETURN
			    AVERAGEX (
			        Last3VisibleMonths,
			        CALCULATE ( [分公司销售数量] )
			    )
		lineageTag: c5362be3-895e-4e5e-a0c6-0d7044408283

		annotation PBI_FormatHint = {"isGeneralNumber":true}

