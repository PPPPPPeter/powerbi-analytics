table DimProductAll
	lineageTag: a28afcbc-c3c5-4b90-af31-67223d06166b

	measure 'Customer Undistributed Flag' =
			
			VAR CurrentSKU =
			    SELECTEDVALUE ( FactBranchCost[Ref Num] )
			
			VAR IsCompanySKU =
			    CALCULATE (
			        [Company SKU Flag],
			        KEEPFILTERS (
			            TREATAS (
			                { CurrentSKU },
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
			
			VAR CurrentQuantity =
			    CALCULATE (
			        SUM ( FactBranchCost[quantity] ),
			        KEEPFILTERS (
			            TREATAS (
			                { CurrentSKU },
			                FactBranchCost[Ref Num]
			            )
			        )
			    )
			
			RETURN
			    IF (
			        NOT ISBLANK ( CurrentSKU )
			            && IsCompanySKU = 1
			            && COALESCE ( CurrentQuantity, 0 ) <= 0,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 4e90d8ea-4116-403f-9d53-3da551208f87

	measure 'Brand Undistributed Customer Count' =
			
			VAR CustomerList =
			    CALCULATETABLE (
			        VALUES ( DimCustomerAll[Customer ID] ),
			        REMOVEFILTERS ( ProductCatalogAll ),
			        REMOVEFILTERS ( ProductCatalog ),
			        REMOVEFILTERS ( DimProductAll )
			    )
			RETURN
			SUMX (
			    CustomerList,
			    CALCULATE ( [Brand Undistributed Customer Flag] )
			)
		formatString: 0
		lineageTag: ae41cac3-bbeb-43db-a199-a6d8a0f52676

	measure 'Brand Distributed Customer Count' =
			
			VAR CustomerList =
			    CALCULATETABLE (
			        VALUES ( DimCustomerAll[Customer ID] ),
			        REMOVEFILTERS ( ProductCatalogAll ),
			        REMOVEFILTERS ( ProductCatalog ),
			        REMOVEFILTERS ( DimProductAll )
			    )
			RETURN
			SUMX (
			    CustomerList,
			    CALCULATE ( [Brand Distributed Customer Flag] )
			)
		formatString: 0
		lineageTag: ca0ad5b6-de51-4e73-af10-134f181c2e26

	measure 'Brand Customer Distribution Rate' =
			
			DIVIDE (
			    [Brand Distributed Customer Count],
			    [Current Period Target Customers]
			)
		lineageTag: aac12488-be90-4b14-a64a-9b84de50c613

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Stock Qty' =
			
			CALCULATE (
			    SUM ( FactInventoryLot[On Hand Qty] ),
			    FactInventoryLot[On Hand Qty] > 0
			)
		formatString: 0
		lineageTag: c4a9e965-3dcc-4e57-b0b5-fb168579de64

	measure 'In Transit Purchase Qty' =
			
			COALESCE (
			    CALCULATE (
			        SUM ( FactPurchaseOrder[Unreceived Qty] ),
			        KEEPFILTERS (
			            FactPurchaseOrder[Purchase Record Type] = "Normal Purchase"
			        ),
			        KEEPFILTERS (
			            FactPurchaseOrder[Unreceived Qty] > 0
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: dbfb88a5-8148-42b0-9f6e-3670e9787c9f

	measure 'SKU Inventory Analysis Display Flag' =
			
			VAR InventoryQty =
			    COALESCE ( [Current Stock Qty], 0 )
			
			VAR Sales30Qty =
			    COALESCE ( [Last 30 Days Sales Qty], 0 )
			
			VAR Sales90Qty =
			    COALESCE ( [Last 90 Days Sales Qty], 0 )
			
			VAR TransitQty =
			    COALESCE ( [In Transit Purchase Qty], 0 )
			
			RETURN
			    IF (
			        InventoryQty > 0
			            || Sales30Qty <> 0
			            || Sales90Qty <> 0
			            || TransitQty > 0,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: a190edb2-b41e-4650-ac51-dc1b52f7b498

	measure 'Last 30 Days Net Sales Qty' =
			
			MAX (
			    COALESCE ( [Last 30 Days Sales Qty], 0 ),
			    0
			)
		lineageTag: c4f8e02c-14f8-4591-a4a3-bd93220efac8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 30 Days Avg Daily Sales' =
			
			DIVIDE (
			    [Last 30 Days Net Sales Qty],
			    30,
			    0
			)
		lineageTag: 464813b7-3b2d-433a-bef1-dc55f3df573f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'In Transit Purchase Qty NJ' =
			
			COALESCE (
			    [In Transit Purchase Qty],
			    0
			)
		lineageTag: 8a9e6966-1c9c-4c9f-9edd-221888307e0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SKU Reorder Lead Time Days' =
			
			ROUND (
			    [SKU Reorder Lead Time],
			    1
			)
		lineageTag: a84760bc-c7e3-43a1-a7f8-6525c9ef1891

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 90 Days Net Sales Qty' =
			
			MAX ( COALESCE ( [Last 90 Days Sales Qty], 0 ), 0 )
		lineageTag: 547dc905-1025-40cc-982c-39ff293af458

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last 3 Months Avg Daily Sales' =
			
			DIVIDE (
			    [Last 3 Months Volume],
			    90,
			    0
			)
		lineageTag: 0a6ce317-4e67-4752-b051-a4d813b26127

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reorder Daily Demand' =
			
			MAX ( [Last 30 Days Avg Daily Sales], [Last 3 Months Avg Daily Sales] )
		lineageTag: 23a44b92-2fd5-4952-9ef6-6a1150a6ee6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Safety Stock Days' = 7
		formatString: 0
		lineageTag: b9356a0d-e5ef-4d2b-a40e-7c76990e8b48

	measure 'Lead Time Demand' =
			
			[Reorder Daily Demand] * [SKU Reorder Lead Time Days]
		lineageTag: f7cb4b57-ec54-4fc1-93b3-76fec3a66314

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Safety Stock Qty' =
			
			[Reorder Daily Demand] * [Safety Stock Days]
		lineageTag: d72218af-d1bf-4e0f-a405-2ce935e9910a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reorder Point' =
			
			[Lead Time Demand] + [Safety Stock Qty]
		lineageTag: 2f2eec0b-454e-40eb-aafc-0c8a84850731

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stock Position' =
			
			COALESCE ( [Current Stock Qty], 0 )
			    + [In Transit Purchase Qty]
		lineageTag: 2d4e1553-0d93-4fd6-8d02-b64077616578

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Stock Days of Cover' =
			
			VAR DailySales =
			    [Last 3 Months Avg Daily Sales]
			
			RETURN
			    IF (
			        DailySales > 0,
			        DIVIDE ( [Current Stock Qty], DailySales ),
			        BLANK ()
			    )
		lineageTag: 288b9695-d919-4d1f-8366-1c1123ff8127

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stock Cover Days Incl In Transit' =
			
			IF (
			    [Reorder Daily Demand] > 0,
			    DIVIDE ( [Stock Position], [Reorder Daily Demand] ),
			    0
			)
		lineageTag: 35a28646-c3ff-4f79-a228-5858c405b503

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Target Stock Days' = 45
		formatString: 0
		lineageTag: 01c2e2f9-d9a1-46db-aa69-b9f080e85431

	measure 'Target Stock Qty' =
			
			[Reorder Daily Demand]
			    * ( [SKU Reorder Lead Time Days] + [Safety Stock Days] + [Target Stock Days] )
		lineageTag: a3c52120-d0d3-4ff0-b695-aee8bdcd2b97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Suggested Order Qty' =
			
			IF (
			    [Stock Position] <= [Reorder Point],
			    ROUNDUP ( MAX ( [Target Stock Qty] - [Stock Position], 0 ), 0 ),
			    0
			)
		lineageTag: 3bcd06d6-1372-42ef-bfd0-83d467d3ce81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Projected Stockout Date' =
			
			VAR CoverDays = [Current Stock Days of Cover]
			RETURN
			    IF (
			        NOT ISBLANK ( CoverDays ),
			        [Inventory As-of Date] + ROUNDUP ( CoverDays, 0 )
			    )
		formatString: Short Date
		lineageTag: ead9e401-e720-4a9c-9ab5-a658b386a675

	measure 'Reorder Status' =
			
			VAR DailySales = [Reorder Daily Demand]
			VAR InventoryQty = COALESCE ( [Current Stock Qty], 0 )
			VAR PositionQty = [Stock Position]
			VAR ReorderPointQty = [Reorder Point]
			RETURN
			    SWITCH (
			        TRUE (),
			        DailySales <= 0 && InventoryQty > 0, "Stock Without Sales",
			        DailySales <= 0, "No Sales",
			        InventoryQty <= 0 && [In Transit Purchase Qty] <= 0, "Out of Stock",
			        InventoryQty <= 0 && [In Transit Purchase Qty] > 0, "Out of Stock - Order In Transit",
			        PositionQty <= ReorderPointQty, "Reorder Needed",
			        "Stock Normal"
			    )
		lineageTag: 47bd8108-ba9c-4a47-9c8f-a31628ac82c5

	measure 'Overstock Threshold Days' = 90
		formatString: 0
		lineageTag: 8d1493c9-81d0-4878-942f-aedc48e66f0d

	measure 'Overstock Qty' =
			
			VAR InventoryQty =
			    COALESCE ( [Current Stock Qty], 0 )
			
			VAR AllowedQty =
			    [Reorder Daily Demand] * [Overstock Threshold Days]
			
			RETURN
			    SWITCH (
			        TRUE (),
			        InventoryQty <= 0, 0,
			        [Reorder Daily Demand] <= 0, InventoryQty,
			        MAX ( InventoryQty - AllowedQty, 0 )
			    )
		lineageTag: 749a5715-31ab-40db-ad5e-4acb68891c7b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unit Base Cost' =
			
			VAR SelectedSKUs =
			    VALUES ( ProductCatalogAll[SKU] )
			
			RETURN
			    CALCULATE (
			        MAX ( FactBranchCost[Base Cost] ),
			        TREATAS (
			            SelectedSKUs,
			            FactBranchCost[Ref Num]
			        )
			    )
		lineageTag: e8e55ea3-a31d-4a2b-92c4-31dcaff13898

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overstock Value' =
			
			[Overstock Qty] * [Unit Base Cost]
		lineageTag: 5a93ce1b-8203-4ad5-9b0a-862d3459f61e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Next 90 Days Expiring Qty' =
			
			VAR BaseDate = [Inventory As-of Date]
			VAR SelectedSKUs = VALUES ( ProductCatalogAll[SKU] )
			RETURN
			    CALCULATE (
			        SUM ( FactInventoryLot[On Hand Qty] ),
			        REMOVEFILTERS ( DimProductAll ),
			        TREATAS ( SelectedSKUs, FactInventoryLot[Product/Internal Reference] ),
			        FactInventoryLot[On Hand Qty] > 0,
			        FactInventoryLot[Expiry Date] >= BaseDate,
			        FactInventoryLot[Expiry Date] <= BaseDate + 90
			    )
		formatString: 0
		lineageTag: 3b044bff-3267-4702-a132-c34fcf95c826

	measure 'Next 90 Days Expiring Value' =
			
			VAR BaseDate =
			    [Inventory As-of Date]
			
			RETURN
			    CALCULATE (
			        SUMX (
			            FactInventoryLot,
			            FactInventoryLot[On Hand Qty]
			                * FactInventoryLot[Product/Base Cost]
			        ),
			        FactInventoryLot[On Hand Qty] > 0,
			        FactInventoryLot[Expiry Date] >= BaseDate,
			        FactInventoryLot[Expiry Date] <= BaseDate + 90
			    )
		lineageTag: a5e41b69-a912-45d7-a01f-087ef597c5c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Urgent Reorder SKU Count' =
			
			VAR CompanySKUs =
			    CROSSJOIN (
			        VALUES ( DimCompany[Company] ),
			        VALUES ( ProductCatalogAll[SKU] )
			    )
			
			RETURN
			    COUNTROWS (
			        FILTER (
			            CompanySKUs,
			            [SKU Inventory Analysis Display Flag] = 1
			                && [Reorder Status]
			                    IN {
			                        "Out of Stock",
			                        "Out of Stock - Order In Transit",
			                        "Reorder Needed"
			                    }
			        )
			    )
		formatString: 0
		lineageTag: 0c9d50da-4b3a-4f38-8cbe-8eac61089e0e

	measure 'Next 60 Days Possible Stockout SKU Count' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [SKU Inventory Analysis Display Flag] = 1
			            && COALESCE ( [Current Stock Qty], 0 ) > 0
			            && [Reorder Daily Demand] > 0
			            && [Current Stock Days of Cover] <= 60
			    )
			)
		formatString: 0
		lineageTag: 5ca9d1f4-d39e-4c15-b3e2-af739e820774

	measure 'Overstock SKU Count' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Overstock Qty] > 0
			    )
			)
		formatString: 0
		lineageTag: 17ffd16c-dbab-4744-ba94-502a8b1d1741

	measure 'Near Expiry Risk SKU Count' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( ProductCatalogAll[SKU] ),
			        [Next 90 Days Expiring Qty] > 0
			    )
			)
		formatString: 0
		lineageTag: a4985c8c-0ae2-4e19-b0df-368d4ad92dae

	measure 'At-Risk Stock Value' =
			
			SUMX (
			    VALUES ( ProductCatalogAll[SKU] ),
			
			    VAR SelectedSKU =
			        ProductCatalogAll[SKU]
			
			    VAR CurrentInventoryAmount =
			        CALCULATE (
			            SUMX (
			                FactInventoryLot,
			                FactInventoryLot[On Hand Qty]
			                    * FactInventoryLot[Product/Base Cost]
			            ),
			            FactInventoryLot[On Hand Qty] > 0,
			            TREATAS (
			                { SelectedSKU },
			                FactInventoryLot[Product/Internal Reference]
			            )
			        )
			
			    VAR CalculatedRiskAmount =
			        COALESCE ( [Overstock Value], 0 )
			            + COALESCE ( [Next 90 Days Expiring Value], 0 )
			
			    RETURN
			        MIN (
			            CurrentInventoryAmount,
			            CalculatedRiskAmount
			        )
			)
		lineageTag: 0396cad0-042e-4317-897f-b241b20fc1b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reorder Urgency Color' =
			
			SWITCH (
			    TRUE (),
			    [Current Stock Qty] <= 0
			        && [In Transit Purchase Qty] <= 0, "#B91C1C",
			    [Current Stock Qty] <= 0, "#EA580C",
			    [Current Stock Days of Cover] <= 60, "#F59E0B",
			    "#3B82F6"
			)
		lineageTag: b387c4e3-fb1b-4ba1-ab41-964bb0c2deea

	measure 'Overstock Risk Color' =
			
			SWITCH (
			    TRUE (),
			    [Reorder Daily Demand] <= 0, "#7C3AED",
			    [Current Stock Days of Cover] > 180, "#B91C1C",
			    [Current Stock Days of Cover] > 90, "#F59E0B",
			    "#64748B"
			)
		lineageTag: 413b45f5-9976-4e51-8814-a6b2deb67572

	measure '60-Day Projected Sales' =
			
			[Last 3 Months Avg Daily Sales] * 60
		lineageTag: 12b2d9d6-8b9f-41d6-a387-680b549bdbcb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Projected Stock After 60 Days' =
			
			[Current Stock Qty] - [60-Day Projected Sales]
		lineageTag: a8ed6b37-08d7-49c1-bc5a-3b8d9f884fb8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stockout Within 60 Days Flag' =
			
			VAR CurrentInventory =
			    COALESCE ( [Current Stock Qty], 0 )
			
			VAR DailySales =
			    [Last 3 Months Avg Daily Sales]
			
			VAR AvailableDays =
			    [Current Stock Days of Cover]
			
			RETURN
			    IF (
			        CurrentInventory > 0
			            && DailySales > 0
			            && AvailableDays <= 60,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 7c95eba6-59fa-4094-9176-854abca64c2b

	measure 'Stockout Within 60 Days Status' =
			
			SWITCH (
			    TRUE (),
			    COALESCE ( [Current Stock Qty], 0 ) <= 0, "Out of Stock",
			    [Stockout Within 60 Days Flag] = 1, "Projected Stockout Within 60 Days",
			    [Last 3 Months Avg Daily Sales] <= 0, "No Recent Sales",
			    "Stock Sufficient"
			)
		lineageTag: a1d7da86-0c1e-4b16-893b-53a162e358c3

	measure 'Expired Stock Qty' =
			
			VAR BaseDate =
			    [Inventory As-of Date]
			
			RETURN
			    CALCULATE (
			        SUM ( FactInventoryLot[On Hand Qty] ),
			        FactInventoryLot[On Hand Qty] > 0,
			        FactInventoryLot[Expiry Date] < BaseDate
			    )
		formatString: 0
		lineageTag: a1816d9a-3666-406d-8a53-faa65b0d7219

	measure 'Near Expiry Stock Flag' =
			
			IF (
			    COALESCE ( [Next 90 Days Expiring Qty], 0 ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 326d281b-cc45-4ffc-bf87-3c61ae2c5718

	column 'Product Name'
		lineageTag: eed8ef6a-d8fe-4265-bbe2-8fc5207c8767
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Name]

		annotation SummarizationSetBy = Automatic

	column Brand
		lineageTag: 5e908a18-9d70-4c0f-a198-4ed99c9e47ce
		summarizeBy: none
		isNameInferred
		sourceColumn: [Brand]

		annotation SummarizationSetBy = Automatic

	column 'Product Group'
		lineageTag: 96d71c45-30d2-45aa-911a-9eeecd52200e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Group]

		annotation SummarizationSetBy = Automatic

	column 'Product Category'
		lineageTag: 36890b63-29a3-443d-8763-fa0cd45edbb2
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Category]

		annotation SummarizationSetBy = Automatic

	column 'Unit of Measure'
		lineageTag: 515ffc17-9855-43a5-9208-c3ad75a785b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Unit of Measure]

		annotation SummarizationSetBy = Automatic

	column 'Current Base Cost'
		lineageTag: a4af7ffa-8389-4aba-8489-0066e7751a7f
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Current Base Cost]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Sales Price'
		lineageTag: bc32fec1-3ad5-495d-9061-5a487c994075
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Sales Price]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Shelf Life Days'
		formatString: 0
		lineageTag: 6d68fd4c-1728-4a42-b4b7-f2b217c6a4e3
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Shelf Life Days]

		annotation SummarizationSetBy = Automatic

	column 'Product Class' =
			
			VAR ProductCategory =
			    TRIM ( COALESCE ( DimProductAll[Product Category], "" ) )
			VAR ProductGroup =
			    TRIM ( COALESCE ( DimProductAll[Product Group], "" ) )
			RETURN
			    SWITCH (
			        TRUE(),
			        ProductCategory = "Ice Cream", "Ice Cream",
			        ProductGroup IN {
			            "Beauty & Health & Home",
			            "Beauty & Health & Home"
			        }, "Beauty",
			        "Other"
			    )
		lineageTag: 30c63395-c845-4d90-8b75-6ee50a4da667
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Company
		lineageTag: 6d96fed7-7d22-43ca-84e0-759c9b207192
		summarizeBy: none
		isNameInferred
		sourceColumn: [Company]

		annotation SummarizationSetBy = Automatic

	column SKU
		lineageTag: 704e30a2-77f2-4bf7-b3a9-fd8b96da2600
		summarizeBy: none
		sourceColumn: FactInventoryLot[Product/Internal Reference]

		annotation SummarizationSetBy = Automatic

	partition DimProductAll = calculated
		mode: import
		source =
				
				SUMMARIZE(
				    FILTER(
				        FactInventoryLot,
				        NOT ISBLANK(FactInventoryLot[Product/Internal Reference])
				            && FactInventoryLot[Product/Internal Reference] <> ""
				    ),
				    FactInventoryLot[Product/Internal Reference],
				
				    "Product Name",
				        MAX(FactInventoryLot[Product/Name]),
				
				    "Product Group",
				        MAX(FactInventoryLot[Product/Product Category/Parent Name]),
				
				    "Product Category",
				        MAX(FactInventoryLot[Product/Product Category/Category Name]),
				
				    "Brand",
				        MAX(FactInventoryLot[Product/CN Brand]),
				
				    "Shelf Life Days",
				        MAX(FactInventoryLot[Product/Expiry Date]),
				
				    "Unit of Measure",
				        MAX(FactInventoryLot[Product/Unit of Measure]),
				
				    "Current Base Cost",
				        MAX(FactInventoryLot[Product/Base Cost]),
				
				    "Sales Price",
				        MAX(FactInventoryLot[Product/Sales Price]),
				
				    "Company",
				        MAX(FactInventoryLot[Company])
				)

	annotation PBI_Id = b4ecfb937a174cea96b3fa90cbc2f778

