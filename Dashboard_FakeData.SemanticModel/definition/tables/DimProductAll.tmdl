	column SKU
		lineageTag: 704e30a2-77f2-4bf7-b3a9-fd8b96da2600
		summarizeBy: none
		sourceColumn: FactInventoryLot[产品/内部参考号]

		annotation SummarizationSetBy = Automatic

	column 产品分类 =
			
			VAR ProductCategory =
			    TRIM ( COALESCE ( DimProductAll[产品类别], "" ) )
			VAR ProductGroup =
			    TRIM ( COALESCE ( DimProductAll[产品大类], "" ) )
			RETURN
			    SWITCH (
			        TRUE(),
			        ProductCategory = "冰淇淋", "冰淇淋",
			        ProductGroup IN {
			            "Beauty & Health & Home",
			            "美容 & 健康 & 居家"
			        }, "美妆",
			        "其他"
			    )
		lineageTag: 30c63395-c845-4d90-8b75-6ee50a4da667
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 公司
		lineageTag: 6d96fed7-7d22-43ca-84e0-759c9b207192
		summarizeBy: none
		isNameInferred
		sourceColumn: [公司]

		annotation SummarizationSetBy = Automatic

	partition DimProductAll = calculated
		mode: import
		source =
				
				SUMMARIZE(
				    FILTER(
				        FactInventoryLot,
				        NOT ISBLANK(FactInventoryLot[产品/内部参考号])
				            && FactInventoryLot[产品/内部参考号] <> ""
				    ),
				    FactInventoryLot[产品/内部参考号],
				
				    "产品名称",
				        MAX(FactInventoryLot[产品/名称]),
				
				    "产品大类",
				        MAX(FactInventoryLot[产品/产品类别/上级名称]),
				
				    "产品类别",
				        MAX(FactInventoryLot[产品/产品类别/中文名称]),
				
				    "品牌",
				        MAX(FactInventoryLot[产品/CN 品牌]),
				
