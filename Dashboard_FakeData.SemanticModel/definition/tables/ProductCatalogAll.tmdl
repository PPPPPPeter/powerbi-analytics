table ProductCatalogAll
	lineageTag: 6f7bf495-9c39-4563-938c-2e0e879ee66f

	column Brand
		lineageTag: 9094247f-655d-4d87-a18a-fa37ef7c4237
		summarizeBy: none
		isNameInferred
		sourceColumn: [Brand]

		annotation SummarizationSetBy = Automatic

	column SKU
		lineageTag: 6fa0b345-6ac4-4e89-b818-54d47e46462f
		summarizeBy: none
		isNameInferred
		sourceColumn: [SKU]

		annotation SummarizationSetBy = Automatic

	column 'Product Name'
		lineageTag: 619dd6be-ad0e-4a7d-a4d0-c9a8bdf9d43c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Name]

		annotation SummarizationSetBy = Automatic

	column 'Product Group'
		lineageTag: eb374546-c08b-4841-bd74-93fcc3e9658b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Group]

		annotation SummarizationSetBy = Automatic

	column 'Product Category'
		lineageTag: 4f114f0d-4550-4ab2-9cf7-934eb3687472
		summarizeBy: none
		isNameInferred
		sourceColumn: [Product Category]

		annotation SummarizationSetBy = Automatic

	column 'Product Class' =
			
			VAR ProductCategory =
			    TRIM ( COALESCE ( ProductCatalogAll[Product Category], "" ) )
			VAR ProductGroup =
			    TRIM ( COALESCE ( ProductCatalogAll[Product Group], "" ) )
			RETURN
			    SWITCH (
			        TRUE(),
			        ProductCategory = "Ice Cream", "Ice Cream",
			        ProductGroup IN {
			            "Beauty & Health & Home",
			            "Beauty & Health & Home"
			        }, "Beauty",
			        "Other"
			    )
		lineageTag: e92cf290-ed41-4013-980a-d606ab59b7bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reorder Status Col' =
			
			VAR DailySales =
			    CALCULATE ( [Reorder Daily Demand] )
			VAR InventoryQty =
			    COALESCE ( CALCULATE ( [Current Stock Qty] ), 0 )
			VAR TransitQty =
			    COALESCE ( CALCULATE ( [In Transit Purchase Qty NJ] ), 0 )
			VAR InventoryPosition =
			    InventoryQty + TransitQty
			VAR ReorderPointQty =
			    COALESCE ( CALCULATE ( [Reorder Point] ), 0 )
			VAR CoverDays =
			    CALCULATE ( [Current Stock Days of Cover] )
			RETURN
			    SWITCH (
			        TRUE (),
			
			        DailySales <= 0 && InventoryQty > 0,
			            "Stock Without Sales",
			
			        DailySales <= 0,
			            "No Sales",
			
			        InventoryQty <= 0 && TransitQty <= 0,
			            "Out of Stock - None In Transit",
			
			        InventoryQty <= 0 && TransitQty > 0,
			            "Out of Stock - Some In Transit",
			
			        CoverDays <= 14,
			            "Possible Stockout Within 14 Days",
			
			        InventoryPosition <= ReorderPointQty,
			            "Regular Reorder Need",
			
			        "Stock Normal"
			    )
		lineageTag: 8073a9ee-7210-49f0-9d35-8ec7e54f8c5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Overstock Status Col' =
			
			VAR DailySales =
			    CALCULATE ( [Reorder Daily Demand] )
			VAR InventoryQty =
			    COALESCE ( CALCULATE ( [Current Stock Qty] ), 0 )
			VAR CoverDays =
			    CALCULATE ( [Current Stock Days of Cover] )
			RETURN
			    SWITCH (
			        TRUE (),
			
			        InventoryQty <= 0,
			            "No Stock",
			
			        DailySales <= 0 && InventoryQty > 0,
			            "Stock Without Sales",
			
			        CoverDays > 180,
			            "Severe Overstock",
			
			        CoverDays > 120,
			            "Overstock",
			
			        CoverDays > 90,
			            "High Stock",
			
			        "Normal"
			    )
		lineageTag: 0de755d7-c19e-4e88-bb2e-552c7582a961
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition ProductCatalogAll = calculated
		mode: import
		source =
				
				VAR ValidRows =
				    FILTER (
				        FactBranchCost,
				        NOT ISBLANK ( FactBranchCost[Ref Num] )
				            && TRIM ( FactBranchCost[Ref Num] ) <> ""
				    )
				RETURN
				SELECTCOLUMNS (
				    SUMMARIZE (
				        ValidRows,
				        FactBranchCost[Ref Num],
				        "Product Name Summary",
				            MAX ( FactBranchCost[product_name] ),
				        "Brand Summary",
				            MAX ( FactBranchCost[brand_cn_name] ),
				        "Product Group Summary",
				            MAX ( FactBranchCost[Category (CN)] ),
				        "Product Category Summary",
				            MAX ( FactBranchCost[Sub-Category (CN)] )
				    ),
				    "SKU", FactBranchCost[Ref Num],
				    "Product Name", [Product Name Summary],
				    "Brand", [Brand Summary],
				    "Product Group", [Product Group Summary],
				    "Product Category", [Product Category Summary]
				)

	annotation PBI_Id = c7d4f2f8279140f69e719c554c771265

