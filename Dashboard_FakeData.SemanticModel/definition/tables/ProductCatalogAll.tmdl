	column 产品类别
		lineageTag: 4f114f0d-4550-4ab2-9cf7-934eb3687472
		summarizeBy: none
		isNameInferred
		sourceColumn: [产品类别]

		annotation SummarizationSetBy = Automatic

	column 产品分类 =
			
			VAR ProductCategory =
			    TRIM ( COALESCE ( ProductCatalogAll[产品类别], "" ) )
			VAR ProductGroup =
			    TRIM ( COALESCE ( ProductCatalogAll[产品大类], "" ) )
			RETURN
			    SWITCH (
			        TRUE(),
			        ProductCategory = "冰淇淋", "冰淇淋",
			        ProductGroup IN {
			            "Beauty & Health & Home",
			            "美容 & 健康 & 居家"
			        }, "美妆",
			        "其他"
			    )
		lineageTag: e92cf290-ed41-4013-980a-d606ab59b7bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 补货状态列 =
			
			VAR DailySales =
			    CALCULATE ( [补货日均销量] )
			VAR InventoryQty =
			    COALESCE ( CALCULATE ( [当前库存数量] ), 0 )
			VAR TransitQty =
			    COALESCE ( CALCULATE ( [在途采购数量NJ] ), 0 )
			VAR InventoryPosition =
			    InventoryQty + TransitQty
			VAR ReorderPointQty =
			    COALESCE ( CALCULATE ( [再订货点] ), 0 )
			VAR CoverDays =
			    CALCULATE ( [当前库存可售天数] )
			RETURN
			    SWITCH (
			        TRUE (),
			
			        DailySales <= 0 && InventoryQty > 0,
			            "无销量库存",
			
			        DailySales <= 0,
			            "无销量",
			
			        InventoryQty <= 0 && TransitQty <= 0,
			            "已断货且无在途",
			
			        InventoryQty <= 0 && TransitQty > 0,
			            "已断货但有在途",
			
			        CoverDays <= 14,
			            "14天内可能断货",
			
			        InventoryPosition <= ReorderPointQty,
			            "一般补货需求",
			
			        "库存正常"
			    )
		lineageTag: 8073a9ee-7210-49f0-9d35-8ec7e54f8c5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 积压状态列 =
			
			VAR DailySales =
			    CALCULATE ( [补货日均销量] )
			VAR InventoryQty =
			    COALESCE ( CALCULATE ( [当前库存数量] ), 0 )
			VAR CoverDays =
			    CALCULATE ( [当前库存可售天数] )
			RETURN
			    SWITCH (
			        TRUE (),
			
			        InventoryQty <= 0,
			            "无库存",
			
			        DailySales <= 0 && InventoryQty > 0,
			            "无销量库存",
			
			        CoverDays > 180,
			            "严重积压",
			
			        CoverDays > 120,
			            "积压",
			
			        CoverDays > 90,
			            "库存偏高",
			
			        "正常"
			    )
		lineageTag: 0de755d7-c19e-4e88-bb2e-552c7582a961
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition ProductCatalogAll = calculated
		mode: import
		source =
				
				VAR ValidRows =
				    FILTER (
				        FactBranchCost,
				        NOT ISBLANK ( FactBranchCost[Ref Num] )
				            && TRIM ( FactBranchCost[Ref Num] ) <> ""
				    )
				RETURN
				SELECTCOLUMNS (
				    SUMMARIZE (
				        ValidRows,
				        FactBranchCost[Ref Num],
				        "产品名称汇总",
				            MAX ( FactBranchCost[product_name] ),
				        "品牌汇总",
				            MAX ( FactBranchCost[brand_cn_name] ),
				        "产品大类汇总",
				            MAX ( FactBranchCost[Category (CN)] ),
				        "产品类别汇总",
				            MAX ( FactBranchCost[Sub-Category (CN)] )
				    ),
				    "SKU", FactBranchCost[Ref Num],
				    "产品名称", [产品名称汇总],
				    "品牌", [品牌汇总],
				    "产品大类", [产品大类汇总],
				    "产品类别", [产品类别汇总]
				)

	annotation PBI_Id = c7d4f2f8279140f69e719c554c771265

