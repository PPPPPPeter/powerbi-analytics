expression DataRoot = "https://raw.githubusercontent.com/PPPPPPeter/powerbi-analytics/main/Data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: b4a0da26-9444-4ac8-b028-1c8e9827624a

	annotation PBI_ResultType = Text

	annotation PBI_NavigationStepName = Navigation

expression PurchaseOrderLines =
		let
		    Source = Csv.Document((if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/purchase_order_lines.csv") else File.Contents(DataRoot & "\purchase_order_lines.csv")),[Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Order Line/Order Reference", type text}, {"Order Line/Product", type text}, {"Order Line/Unit Price", type number}, {"Order Line/Quantity", Int64.Type}, {"Order Line/Received Qty", Int64.Type}, {"Order Line/Subtotal", type number}, {"Order Line/Confirmed Date", type datetime}, {"Order Line/Expected Arrival Time", type datetime}, {"Order Line/Partner", type text}, {"Order Line/Company", type text}, {"Order Line/Created By", type text}, {"Order Line/Status", type text}, {"Order Line/Order Reference/Actual Ship Date", type date}})
		in
		    #"Changed Type"
	lineageTag: f3d4ac19-141e-4fef-b649-7157a952f68d

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

